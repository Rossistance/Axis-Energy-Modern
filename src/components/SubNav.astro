---
interface Props {
  items: { label: string; href: string }[];
  label?: string;
}

const { items, label = 'On this page' } = Astro.props;
---

<nav class="subnav" aria-label={label} data-subnav>
  <div class="container subnav__inner">
    <span class="subnav__label">{label}</span>
    <ul>
      {items.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .subnav {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: rgba(255, 255, 255, 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .subnav__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .subnav__inner::-webkit-scrollbar {
    display: none;
  }

  .subnav__label {
    display: none;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .subnav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .subnav a {
    display: inline-block;
    padding: 0.9rem 0.75rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  .subnav a:hover,
  .subnav a[aria-current='true'] {
    color: var(--brand-blue);
    border-bottom-color: var(--brand-green);
  }

  @media (min-width: 900px) {
    .subnav__label {
      display: inline-block;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-subnav]');
  if (nav && 'IntersectionObserver' in window) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const sections = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => !!el);
    const setActive = (id: string) =>
      links.forEach((a) => {
        if (a.hash === `#${id}`) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.2, 0.5] },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
