---
import { Icon } from 'astro-icon/components';
import HeroCarousel from '@components/HeroCarousel.astro';
import type { CarouselSlide } from '@lib/projects';
import { href } from '@lib/href';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  /** Project photos shown in the carousel beside the headline. */
  slides: CarouselSlide[];
  /** Highlight links that float over the photos on desktop and sit above them on phones. */
  chips?: { icon: string; label: string; href: string }[];
  trust?: string[];
}

const { eyebrow, title, lead, primary, secondary, slides, chips = [], trust = [] } = Astro.props;
---

<section class="hero band-dark" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="hero-title">{title}</h1>
      <p class="lead">{lead}</p>
      <div class="cluster hero__actions">
        <a class="btn btn--primary btn--lg" href={href(primary.href)}>
          {primary.label}
        </a>
        {secondary && (
          <a class="btn btn--secondary btn--lg" href={href(secondary.href)}>
            {secondary.label}
            <Icon name="lucide:arrow-right" class="icon" />
          </a>
        )}
      </div>
    </div>

    <div class="hero__media">
      {chips.length > 0 && (
        <ul class="hero__chips" aria-label="Highlights">
          {chips.map((chip, i) => (
            <li class:list={['hero__chip-item', `hero__chip-item--${i + 1}`]}>
              <a class="hero__chip" href={href(chip.href)}>
                <Icon name={chip.icon} class="hero__chip-icon" />
                <span>{chip.label}</span>
                <Icon name="lucide:arrow-right" class="hero__chip-arrow" />
              </a>
            </li>
          ))}
        </ul>
      )}
      <HeroCarousel slides={slides} />
    </div>
  </div>

  {trust.length > 0 && (
    <div class="container">
      <ul class="hero__trust" aria-label="Credentials">
        {trust.map((item) => (
          <li>
            <Icon name="lucide:check" />
            {item}
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.75rem, 3.6vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60vw;
    max-width: 900px;
    aspect-ratio: 1;
    background: radial-gradient(circle at center, rgba(63, 207, 196, 0.28), transparent 62%);
    filter: blur(10px);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero__copy h1 {
    color: #fff;
    max-width: 14ch;
  }

  .hero__copy .lead {
    max-width: 48ch;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.4rem);
  }

  .hero__actions {
    margin-top: 1.5rem;
  }

  .hero__media {
    position: relative;
    width: 100%;
  }

  /* Phones and tablets: the highlights sit in a row above the photos. */
  .hero__chips {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 36px;
    padding: 0.45rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.2;
    text-decoration: none;
    transition:
      transform var(--dur-1, 150ms) ease,
      box-shadow var(--dur-1, 150ms) ease,
      background-color var(--dur-1, 150ms) ease;
  }

  .hero__chip:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .hero__chip :global(.hero__chip-icon) {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--aqua-400);
  }

  .hero__chip :global(.hero__chip-arrow) {
    width: 14px;
    height: 14px;
    flex: none;
    opacity: 0.6;
    transition:
      transform var(--dur-1, 150ms) ease,
      opacity var(--dur-1, 150ms) ease;
  }

  .hero__chip:hover :global(.hero__chip-arrow) {
    opacity: 1;
    transform: translateX(2px);
  }

  .hero__trust {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Phones: the highlight bubbles already carry these facts; skip the repeat. */
  @media (max-width: 639px) {
    .hero__trust {
      display: none;
    }
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__trust :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--aqua-400);
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    }

    /* Desktop: the highlights float over the edges of the photo frame (same 3:2 box). */
    .hero__chips {
      position: absolute;
      inset: 0 0 auto;
      z-index: 4;
      aspect-ratio: 3 / 2;
      display: block;
      margin: 0;
      pointer-events: none;
    }

    .hero__chip-item {
      position: absolute;
      pointer-events: auto;
    }

    .hero__chip-item--1 {
      top: 7%;
      left: -5%;
    }

    .hero__chip-item--2 {
      top: 33%;
      right: -6%;
    }

    .hero__chip-item--3 {
      top: 58%;
      left: -4%;
    }

    .hero__chip {
      border-color: transparent;
      background: rgba(255, 255, 255, 0.94);
      color: var(--brand-navy);
      box-shadow: var(--shadow-2);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }

    .hero__chip:hover {
      background: #fff;
      transform: translateY(-2px);
      box-shadow: var(--shadow-3);
    }

    .hero__chip :global(.hero__chip-icon) {
      color: var(--brand-green);
    }
  }
</style>
