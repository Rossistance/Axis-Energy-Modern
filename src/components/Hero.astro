---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import { href } from '@lib/href';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  art: ImageMetadata;
  chips?: { icon: string; label: string }[];
  trust?: string[];
}

const { eyebrow, title, lead, primary, secondary, art, chips = [], trust = [] } = Astro.props;
---

<section class="hero band-dark" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="hero-title">{title}</h1>
      <p class="lead">{lead}</p>
      <div class="cluster hero__actions">
        <a class="btn btn--primary btn--lg" href={href(primary.href)}>
          {primary.label}
        </a>
        {secondary && (
          <a class="btn btn--secondary btn--lg" href={href(secondary.href)}>
            {secondary.label}
            <Icon name="lucide:arrow-right" class="icon" />
          </a>
        )}
      </div>
    </div>

    <div class="hero__art-wrap">
      <div class="hero__art hero-art--drift">
        <Picture
          src={art}
          alt=""
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          pictureAttributes={{ class: 'hero__picture' }}
        />
      </div>
      {chips.map((chip, i) => (
        <span class:list={['hero__chip', `hero__chip--${i + 1}`]} aria-hidden="true">
          <Icon name={chip.icon} />
          {chip.label}
        </span>
      ))}
    </div>
  </div>

  {trust.length > 0 && (
    <div class="container">
      <ul class="hero__trust" aria-label="Credentials">
        {trust.map((item) => (
          <li>
            <Icon name="lucide:check" />
            {item}
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60vw;
    max-width: 900px;
    aspect-ratio: 1;
    background: radial-gradient(circle at center, rgba(63, 207, 196, 0.28), transparent 62%);
    filter: blur(10px);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero__copy h1 {
    color: #fff;
    max-width: 14ch;
  }

  .hero__copy .lead {
    max-width: 48ch;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.4rem);
  }

  .hero__actions {
    margin-top: 2rem;
  }

  .hero__art-wrap {
    position: relative;
    max-width: 640px;
    margin-inline: auto;
    width: 100%;
  }

  .hero__art {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    box-shadow: var(--shadow-3);
    isolation: isolate;
  }

  .hero__art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    background: linear-gradient(160deg, transparent 55%, rgba(0, 35, 82, 0.55));
    pointer-events: none;
  }

  .hero__art :global(picture) {
    position: absolute;
    inset: 0;
  }

  .hero__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: center;
  }

  .hero__chip {
    position: absolute;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.92);
    color: var(--brand-navy);
    font-weight: 600;
    font-size: 0.85rem;
    box-shadow: var(--shadow-2);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .hero__chip :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--brand-green);
  }

  .hero__chip--1 {
    top: 8%;
    left: -6%;
  }

  .hero__chip--2 {
    top: 46%;
    right: -7%;
  }

  .hero__chip--3 {
    bottom: 9%;
    left: 6%;
  }

  .hero__trust {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__trust :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--aqua-400);
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .hero__chip {
      display: inline-flex;
    }
  }
</style>
