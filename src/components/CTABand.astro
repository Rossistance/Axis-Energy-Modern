---
import { Icon } from 'astro-icon/components';
import { company } from '@data/company';
import { workWithAxis } from '@data/nav';
import { routes } from '@data/routes';
import { href } from '@lib/href';

interface Props {
  compact?: boolean;
  title?: string;
  body?: string;
}

const {
  compact = false,
  title = 'Let’s talk about your next successful renewable energy project.',
  body = 'Give us a call or drop us an email and let’s talk about your next successful renewable energy project.',
} = Astro.props;
---

<section
  class:list={['cta-band', 'band-dark', { 'cta-band--compact': compact }]}
  aria-labelledby="cta-title"
>
  <div class="cta-band__glow" aria-hidden="true"></div>
  <div class="container cta-band__inner">
    <div class="cta-band__copy" data-reveal>
      <p class="eyebrow">Let’s Connect</p>
      <h2 id="cta-title">{title}</h2>
      {!compact && <p class="lead">{body}</p>}
      <div class="cluster cta-band__actions">
        <a class="btn btn--primary btn--lg" href={href(workWithAxis.href)}>
          {workWithAxis.label}
        </a>
        <a class="btn btn--secondary btn--lg" href={href(routes.contact)}>
          Talk to us
        </a>
      </div>
    </div>
    <ul class="cta-band__contact" data-reveal>
      <li>
        <Icon name="lucide:phone" />
        <span>
          <a href={`tel:${company.phone.tel}`}>{company.phone.display}</a>
          <small>
            {company.primaryContact.name}, {company.primaryContact.title}
          </small>
        </span>
      </li>
      <li>
        <Icon name="lucide:mail" />
        <span>
          <a href={`mailto:${company.email}`}>{company.email}</a>
          <small>We respond within one business day</small>
        </span>
      </li>
      <li>
        <Icon name="lucide:map-pin" />
        <span>
          <a href={company.address.mapsUrl} rel="noopener" target="_blank">
            {company.address.street}
          </a>
          <small>
            {company.address.city}, {company.address.state} {company.address.zip}
          </small>
        </span>
      </li>
      <li>
        <Icon name="lucide:clock" />
        <span>
          {company.hours}
          <small>Eastern time</small>
        </span>
      </li>
    </ul>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-y);
  }

  .cta-band--compact {
    padding-block: var(--section-y-sm);
  }

  .cta-band__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 80% at 85% 20%, rgba(63, 207, 196, 0.22), transparent 70%),
      radial-gradient(50% 70% at 10% 90%, rgba(0, 135, 82, 0.2), transparent 70%),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.035) 0,
        rgba(255, 255, 255, 0.035) 1px,
        transparent 1px,
        transparent 96px
      );
    pointer-events: none;
  }

  .cta-band__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .cta-band__copy h2 {
    color: #fff;
    max-width: 18ch;
  }

  .cta-band__actions {
    margin-top: 1.75rem;
  }

  .cta-band__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .cta-band__contact li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .cta-band__contact :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--aqua-400);
    margin-top: 0.15rem;
  }

  .cta-band__contact span {
    display: grid;
  }

  .cta-band__contact a {
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .cta-band__contact a:hover {
    text-decoration: underline;
  }

  .cta-band__contact small {
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .cta-band__inner {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
