---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { href } from '@lib/href';
import { formatDate, readingTime } from '@lib/format';

interface Props {
  post: CollectionEntry<'news'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { data } = post;
const url = href(`/news/${post.id}/`);
const minutes = readingTime(post.body ?? '');
---

<article class:list={['news-card', 'card', 'card--lift', { 'news-card--featured': featured }]}>
  <p class="news-card__meta">
    <span class="badge">{data.category}</span>
    <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
    <span>{minutes} min read</span>
  </p>
  <h3>
    <a href={url}>{data.title}</a>
  </h3>
  <p class="news-card__excerpt">{data.excerpt}</p>
  <p class="news-card__author">By {data.author}</p>
  <a class="link-arrow" href={url}>
    Read article <Icon name="lucide:arrow-right" class="icon" />
  </a>
</article>

<style>
  .news-card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .news-card--featured {
    background: linear-gradient(135deg, rgba(0, 75, 141, 0.05), rgba(0, 135, 82, 0.07));
  }

  .news-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
  }

  .news-card h3 {
    font-size: 1.35rem;
    margin: 0;
  }

  .news-card--featured h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
  }

  .news-card h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .news-card h3 a:hover {
    color: var(--brand-blue);
  }

  .news-card__excerpt {
    color: var(--text-muted);
    margin: 0;
  }

  .news-card__author {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }
</style>
