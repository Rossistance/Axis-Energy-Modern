---
import type { Stat } from '@data/stats';

interface Props {
  stats: Stat[];
  variant?: 'light' | 'dark' | 'overlap';
  note?: string;
}

const { stats, variant = 'light', note } = Astro.props;
const visible = stats.filter((s) => s.confirmed);
---

<div class:list={['stat-strip', `stat-strip--${variant}`]} data-reveal-group>
  {visible.map((s) => (
    <div class="stat">
      <p
        class="stat__value tabular"
        data-count={s.numeric ?? undefined}
        data-suffix={s.suffix ?? ''}
      >
        {s.value}
      </p>
      <p class="stat__label">{s.label}</p>
    </div>
  ))}
  {note && <p class="stat-strip__note">{note}</p>}
</div>

<style>
  .stat-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 1.25rem;
    position: relative;
  }

  .stat {
    padding: 1.25rem 1.35rem;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .stat-strip--overlap {
    margin-top: calc(-1 * clamp(2rem, 5vw, 3.5rem));
    z-index: 2;
  }

  .stat-strip--overlap .stat {
    background: #fff;
    box-shadow: var(--shadow-2);
    border-color: transparent;
  }

  .stat__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 0.4rem;
  }

  .band-dark .stat__value,
  .stat-strip--dark .stat__value {
    background: linear-gradient(90deg, #fff, var(--aqua-200));
    -webkit-background-clip: text;
    background-clip: text;
  }

  .stat__label {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .stat-strip__note {
    grid-column: 1 / -1;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (els.length && 'IntersectionObserver' in window && !reduce) {
    const fmt = (n: number, decimals: number) =>
      n.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      });
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      const suffix = el.dataset.suffix ?? '';
      const decimals = String(el.dataset.count).includes('.') ? 1 : 0;
      const start = performance.now();
      const dur = 1100;
      const tick = (t: number) => {
        const p = Math.min(1, (t - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * eased, decimals) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            run(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.4 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
