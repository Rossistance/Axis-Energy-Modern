---
/**
 * A client's own words with their name, title and company. A quote not yet approved for
 * publication shows only in preview builds, marked "Pending approval" (src/data/testimonials.ts).
 */
import type { Testimonial } from '@data/testimonials';

interface Props {
  testimonial: Testimonial;
}

const { testimonial: t } = Astro.props;
---

<figure class="testimonial">
  {!t.approved && <p class="testimonial__pending">Pending approval</p>}
  <blockquote>
    <p>“{t.quote}”</p>
  </blockquote>
  <figcaption>
    <strong>{t.name}</strong>
    <span>
      {t.title}, {t.company}
    </span>
  </figcaption>
</figure>

<style>
  .testimonial {
    margin: 0;
    padding: clamp(1.1rem, 2.5vw, 1.5rem) clamp(1.1rem, 2.5vw, 1.75rem);
    border-left: 4px solid var(--brand-green);
    border-radius: 0 var(--r-md, 12px) var(--r-md, 12px) 0;
    background: var(--surface-alt, #f5f8fa);
  }

  .testimonial blockquote {
    margin: 0;
  }

  .testimonial blockquote p {
    margin: 0;
    font-size: clamp(1.02rem, 0.98rem + 0.25vw, 1.15rem);
    line-height: 1.55;
    color: var(--text);
  }

  .testimonial figcaption {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.1rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .testimonial figcaption strong {
    color: var(--brand-navy);
    font-size: 0.95rem;
  }

  .testimonial__pending {
    display: inline-block;
    margin: 0 0 0.6rem;
    padding: 0.1em 0.55em;
    border-radius: 999px;
    background: #fff4dc;
    color: #6b4200;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
