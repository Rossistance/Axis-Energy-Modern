---
import { Icon } from 'astro-icon/components';

interface Props {
  quote: string;
  name: string;
  title: string;
  variant?: 'card' | 'feature';
}

const { quote, name, title, variant = 'card' } = Astro.props;
---

<figure class:list={['testimonial', `testimonial--${variant}`]} data-reveal>
  <Icon name="lucide:quote" class="testimonial__mark" />
  <blockquote>
    <p>{quote}</p>
  </blockquote>
  <figcaption>
    <strong>{name}</strong>
    <span>{title}</span>
  </figcaption>
</figure>

<style>
  .testimonial {
    margin: 0;
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--r-xl);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .testimonial--feature {
    background: linear-gradient(135deg, rgba(0, 75, 141, 0.06), rgba(0, 135, 82, 0.08));
    border-color: transparent;
  }

  .testimonial :global(.testimonial__mark) {
    width: 40px;
    height: 40px;
    color: var(--brand-green);
    opacity: 0.6;
    margin-bottom: 1rem;
  }

  .testimonial blockquote p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .testimonial figcaption {
    margin-top: 1.25rem;
    display: grid;
    font-size: var(--text-sm);
  }

  .testimonial figcaption span {
    color: var(--text-muted);
  }
</style>
