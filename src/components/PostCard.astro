---
/**
 * A LinkedIn post on the News page: photo, date, headline (the post's title or opening
 * line), a short summary, and links that open the post on LinkedIn.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { formatDate } from '@lib/format';
import { truncate } from '@lib/news/text';
import type { Post } from '@lib/news';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const heading = post.title ?? truncate(post.summary, 140);
const body = post.title ? post.summary : '';
const remote = typeof post.image === 'string' ? post.image : undefined;
/** LinkedIn photo URLs expire, so those are copied into the build (see astro.config.mjs). */
const copyIntoBuild = !!remote && /(^|\.)licdn\.com$/.test(new URL(remote).hostname);
---

<article class="post-card card card--lift">
  <a
    class="post-card__media"
    href={post.url}
    target="_blank"
    rel="noopener"
    aria-hidden="true"
    tabindex="-1"
  >
    {post.image && typeof post.image !== 'string' && (
      <Image
        src={post.image}
        alt=""
        widths={[400, 640, 900]}
        sizes="(min-width: 900px) 33vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    )}
    {remote && copyIntoBuild && (
      <Image
        src={remote}
        alt=""
        inferSize
        widths={[400, 640, 900]}
        sizes="(min-width: 900px) 33vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    )}
    {remote && !copyIntoBuild && <img src={remote} alt="" loading="lazy" decoding="async" />}
    {!post.image && (
      <span class="post-card__nophoto">
        <Icon name="lucide:linkedin" />
      </span>
    )}
    {post.sample && <span class="badge post-card__sample">Sample</span>}
  </a>
  <div class="post-card__body">
    <p class="post-card__meta">
      <Icon name="lucide:linkedin" />
      <time datetime={post.date}>{formatDate(new Date(post.date))}</time>
    </p>
    <h3 class="post-card__title">
      <a href={post.url} target="_blank" rel="noopener">
        {heading}
        <span class="sr-only"> (opens LinkedIn in a new tab)</span>
      </a>
    </h3>
    {body && <p class="post-card__summary">{body}</p>}
    <span class="link-arrow post-card__more" aria-hidden="true">
      View on LinkedIn <Icon name="lucide:external-link" class="icon" />
    </span>
  </div>
</article>

<style>
  .post-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .post-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--navy-deep);
    overflow: hidden;
  }

  .post-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .post-card:hover .post-card__media :global(img) {
    transform: scale(1.04);
  }

  .post-card__nophoto {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--grad-band);
    color: rgba(255, 255, 255, 0.6);
  }

  .post-card__nophoto :global(svg) {
    width: 40px;
    height: 40px;
  }

  .post-card__sample {
    position: absolute;
    left: 0.9rem;
    top: 0.9rem;
    background: #fff;
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
    padding: 1.15rem 1.35rem 1.35rem;
  }

  .post-card__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .post-card__meta :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--brand-blue);
  }

  /* Post headlines are sentences, so they use the body face rather than the display one. */
  .post-card__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .post-card__title a {
    color: var(--text);
    text-decoration: none;
  }

  .post-card__title a:hover {
    color: var(--brand-blue);
  }

  .post-card__summary {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .post-card__more {
    margin-top: auto;
    padding-top: 0.35rem;
    color: var(--link);
  }
</style>
