---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { src: ImageMetadata; alt: string; caption: string; wide?: boolean }[];
  duotone?: boolean;
}

const { photos, duotone = true } = Astro.props;
---

<div class="photo-band" data-reveal-group>
  {photos.map((p) => (
    <figure class:list={['photo', { 'photo--duotone': duotone, 'photo--wide': p.wide }]}>
      <Image
        src={p.src}
        alt={p.alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 33vw, 100vw"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="photo__caption">{p.caption}</figcaption>
    </figure>
  ))}
</div>

<style>
  .photo-band {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .photo-band .photo {
    aspect-ratio: 4 / 3;
    margin: 0;
  }

  .photo-band .photo--wide {
    grid-column: span 2;
    aspect-ratio: 8 / 3;
  }

  @media (max-width: 640px) {
    .photo-band .photo--wide {
      grid-column: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
