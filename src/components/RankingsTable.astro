---
import { rankings } from '@data/stats';
---

<div class="table-wrap rankings-wrap" data-reveal>
  <table class="table rankings">
    <caption class="sr-only">
      Solar Power World Top Solar Contractors rankings for Axis Energy
    </caption>
    <thead>
      <tr>
        <th scope="col">Year</th>
        <th scope="col">
          <span class="rankings__long">National rank</span>
          <span class="rankings__short" aria-hidden="true">
            Rank
          </span>
        </th>
        <th scope="col">Category</th>
        <th scope="col" class="num">
          <span class="rankings__long">kW installed (prior year)</span>
          <span class="rankings__short" aria-hidden="true">
            kW
          </span>
        </th>
      </tr>
    </thead>
    <tbody>
      {rankings.map((r) => (
        <tr>
          <td class="tabular">{r.year}</td>
          <td class="rankings__rank">#{r.rank}</td>
          <td>{r.category}</td>
          <td class="num">{r.kw.toLocaleString('en-US')}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="rankings__source">
  Source: Solar Power World Top Solar Contractors lists, 2021–2026. Each list ranks kW installed in
  the prior year.
</p>

<style>
  /* Query container: the table fits whatever column it is placed in (see below), and the
     wrapper never widens that column to the table's own width. */
  .rankings-wrap {
    container-type: inline-size;
  }

  .rankings {
    min-width: 520px;
  }

  .rankings__rank {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--brand-blue);
  }

  .rankings__short {
    display: none;
  }

  /* Narrow columns (the News sidebar, phones): short headings and tighter cells so all four
     columns fit without scrolling. Screen readers still get the full headings. */
  @container (max-width: 519px) {
    .rankings {
      min-width: 0;
    }

    .rankings th,
    .rankings td {
      padding: 0.65rem 0.55rem;
    }

    .rankings__long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .rankings__short {
      display: inline;
    }
  }

  .rankings__source {
    margin-top: 0.75rem;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
