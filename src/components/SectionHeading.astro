---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center' | 'row';
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
}

const { eyebrow, title, lead, align = 'left', as: Tag = 'h2', id } = Astro.props;
---

<div
  class:list={[
    'section-heading',
    { 'section-heading--center': align === 'center', 'section-heading--row': align === 'row' },
  ]}
  data-reveal
>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag id={id}>{title}</Tag>
    {lead && <p class="lead">{lead}</p>}
  </div>
  {align === 'row' && (
    <div class="section-heading__aside">
      <slot />
    </div>
  )}
</div>
