---
import { Icon } from 'astro-icon/components';
import { primaryNav, headerCta } from '@data/nav';
import { company } from '@data/company';
import { href, isActive } from '@lib/href';

const current = Astro.url.pathname;
const flat = primaryNav.flatMap((item) => (item.children ? item.children : [item]));
---

<dialog id="site-drawer" class="drawer" aria-label="Site menu" data-drawer>
  <div class="drawer__panel">
    <div class="drawer__top">
      <span class="drawer__title">Menu</span>
      <button type="button" class="drawer__close" data-drawer-close>
        <Icon name="lucide:x" />
        <span class="sr-only">Close menu</span>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="drawer__list">
        {flat.map((item) => (
          <li>
            <a
              href={href(item.href)}
              aria-current={isActive(item.href, current, true) ? 'page' : undefined}
            >
              {item.label}
              <Icon name="lucide:arrow-right" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="drawer__cta">
      <a class="btn btn--primary" href={href(headerCta.href)}>
        {headerCta.label}
      </a>
      <a class="btn btn--secondary" href={href('/subcontractors/')}>
        Subcontractors
      </a>
    </div>
    <div class="drawer__contact">
      <a href={`tel:${company.phone.tel}`}>
        <Icon name="lucide:phone" /> {company.phone.display}
      </a>
      <a href={`mailto:${company.email}`}>
        <Icon name="lucide:mail" /> {company.email}
      </a>
    </div>
  </div>
</dialog>

<style>
  .drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .drawer::backdrop {
    background: rgba(0, 35, 82, 0.55);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .drawer__panel {
    margin-left: auto;
    width: min(400px, 100%);
    height: 100%;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.1rem 1.25rem 2rem;
    overflow-y: auto;
    box-shadow: var(--shadow-3);
    animation: drawer-in var(--dur-3) var(--ease-out);
  }

  @keyframes drawer-in {
    from {
      transform: translateX(24px);
      opacity: 0;
    }

    to {
      transform: none;
      opacity: 1;
    }
  }

  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .drawer__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .drawer__close {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
  }

  .drawer__close :global(svg) {
    width: 22px;
    height: 22px;
  }

  .drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .drawer__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    text-decoration: none;
  }

  .drawer__list a[aria-current='page'] {
    color: var(--brand-blue);
  }

  .drawer__list :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--brand-green);
  }

  .drawer__cta {
    display: grid;
    gap: 0.6rem;
  }

  .drawer__contact {
    display: grid;
    gap: 0.5rem;
    font-size: var(--text-sm);
  }

  .drawer__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 500;
  }

  .drawer__contact :global(svg) {
    width: 16px;
    height: 16px;
  }

  :global(body:has(dialog[open].drawer)) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer__panel {
      animation: none;
    }
  }
</style>

<script>
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  if (drawer && openBtn) {
    const setState = (open: boolean) => openBtn.setAttribute('aria-expanded', String(open));
    openBtn.addEventListener('click', () => {
      drawer.showModal();
      setState(true);
    });
    drawer.querySelector('[data-drawer-close]')?.addEventListener('click', () => drawer.close());
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.close();
    });
    drawer.addEventListener('close', () => {
      setState(false);
      openBtn.focus();
    });
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => drawer.close()));
  }
</script>
