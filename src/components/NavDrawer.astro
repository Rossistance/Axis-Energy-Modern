---
import { Icon } from 'astro-icon/components';
import { primaryNav, workWithAxis, type NavItem } from '@data/nav';
import { company } from '@data/company';
import { href, isActive } from '@lib/href';

const current = Astro.url.pathname;
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
/** A group starts open when the current page is inside it. */
const inGroup = (item: NavItem): boolean =>
  isActive(item.href, current) || !!item.children?.some((c) => inGroup(c));
---

<dialog id="site-drawer" class="drawer" aria-label="Site menu" data-drawer>
  <div class="drawer__panel">
    <div class="drawer__top">
      <span class="drawer__title">Menu</span>
      <button type="button" class="drawer__close" data-drawer-close>
        <Icon name="lucide:x" />
        <span class="sr-only">Close menu</span>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="drawer__list">
        {primaryNav.map((item) => {
          if (!item.children) {
            return (
              <li>
                <a
                  href={href(item.href)}
                  aria-current={isActive(item.href, current, true) ? 'page' : undefined}
                >
                  {item.label}
                  <Icon name="lucide:arrow-right" />
                </a>
              </li>
            );
          }
          const id = `drawer-${slugify(item.label)}`;
          const open = inGroup(item);
          return (
            <li class="drawer__group">
              <div class="drawer__row">
                <a
                  href={href(item.href)}
                  aria-current={isActive(item.href, current, true) ? 'page' : undefined}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  class="drawer__expand"
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls={id}
                  aria-label={`${item.label} pages`}
                  data-drawer-expand
                >
                  <Icon name="lucide:chevron-down" />
                </button>
              </div>
              <ul class="drawer__sublist" id={id} hidden={!open}>
                {item.children.map((child) => {
                  const link = (
                    <a
                      href={href(child.href)}
                      aria-current={isActive(child.href, current, true) ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  );
                  if (!child.children) return <li>{link}</li>;
                  const childId = `${id}-${slugify(child.label)}`;
                  const childOpen = inGroup(child);
                  const kind = child.href.includes('#') ? 'sections' : 'pages';
                  return (
                    <li>
                      <div class="drawer__row drawer__row--sub">
                        {link}
                        <button
                          type="button"
                          class="drawer__expand drawer__expand--sub"
                          aria-expanded={childOpen ? 'true' : 'false'}
                          aria-controls={childId}
                          aria-label={`${child.label} ${kind}`}
                          data-drawer-expand
                        >
                          <Icon name="lucide:chevron-down" />
                        </button>
                      </div>
                      <ul class="drawer__nested" id={childId} hidden={!childOpen}>
                        {child.children.map((grandchild) => (
                          <li>
                            <a
                              href={href(grandchild.href)}
                              aria-current={
                                isActive(grandchild.href, current, true) ? 'page' : undefined
                              }
                            >
                              {grandchild.label}
                            </a>
                            {grandchild.children && (
                              <ul class="drawer__deep" aria-label={grandchild.label}>
                                {grandchild.children.map((item) => (
                                  <li>
                                    <a href={href(item.href)}>{item.label}</a>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="drawer__cta">
      <a class="drawer__cta-title" href={href(workWithAxis.href)}>
        {workWithAxis.label}
      </a>
      {workWithAxis.children.map((child, i) => (
        <a
          class:list={['btn', i === 0 ? 'btn--primary' : 'btn--secondary']}
          href={href(child.href)}
        >
          {child.label}
        </a>
      ))}
    </div>
    <div class="drawer__contact">
      <a href={`tel:${company.phone.tel}`}>
        <Icon name="lucide:phone" /> {company.phone.display}
      </a>
      <a href={`mailto:${company.email}`}>
        <Icon name="lucide:mail" /> {company.email}
      </a>
    </div>
  </div>
</dialog>

<style>
  .drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .drawer::backdrop {
    background: rgba(0, 35, 82, 0.55);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .drawer__panel {
    margin-left: auto;
    width: min(400px, 100%);
    height: 100%;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.1rem 1.25rem 2rem;
    overflow-y: auto;
    box-shadow: var(--shadow-3);
    animation: drawer-in var(--dur-3) var(--ease-out);
  }

  @keyframes drawer-in {
    from {
      transform: translateX(24px);
      opacity: 0;
    }

    to {
      transform: none;
      opacity: 1;
    }
  }

  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .drawer__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .drawer__close {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
  }

  .drawer__close :global(svg) {
    width: 22px;
    height: 22px;
  }

  .drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .drawer__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    text-decoration: none;
  }

  .drawer__list a[aria-current='page'] {
    color: var(--brand-blue);
  }

  .drawer__row {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--line);
  }

  .drawer__list .drawer__row > a {
    flex: 1;
    border-bottom: 0;
  }

  .drawer__expand {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 48px;
    border: 0;
    background: none;
    color: var(--brand-green);
    cursor: pointer;
  }

  .drawer__expand :global(svg) {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .drawer__expand[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .drawer__row--sub {
    border-bottom: 0;
  }

  .drawer__expand--sub {
    width: 40px;
    color: var(--ink-muted);
  }

  .drawer__sublist,
  .drawer__nested {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .drawer__sublist {
    padding: 0.25rem 0 0.5rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .drawer__list .drawer__sublist a {
    padding: 0.55rem 0.25rem;
    border-bottom: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
  }

  .drawer__list .drawer__nested {
    margin: 0 0 0.35rem 0.35rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--mist-200);
  }

  .drawer__list .drawer__nested a {
    padding: 0.4rem 0.25rem;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }

  .drawer__list .drawer__deep {
    list-style: none;
    margin: 0 0 0.2rem 0.35rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--mist-200);
  }

  .drawer__list .drawer__deep a {
    padding-block: 0.3rem;
    font-size: 0.9rem;
  }

  .drawer__list :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--brand-green);
  }

  .drawer__cta {
    display: grid;
    gap: 0.6rem;
  }

  .drawer__cta-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    text-decoration: none;
  }

  .drawer__contact {
    display: grid;
    gap: 0.5rem;
    font-size: var(--text-sm);
  }

  .drawer__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 500;
  }

  .drawer__contact :global(svg) {
    width: 16px;
    height: 16px;
  }

  :global(body:has(dialog[open].drawer)) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer__panel {
      animation: none;
    }
  }
</style>

<script>
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  if (drawer && openBtn) {
    const setState = (open: boolean) => openBtn.setAttribute('aria-expanded', String(open));
    openBtn.addEventListener('click', () => {
      drawer.showModal();
      setState(true);
    });
    drawer.querySelector('[data-drawer-close]')?.addEventListener('click', () => drawer.close());
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.close();
    });
    drawer.addEventListener('close', () => {
      setState(false);
      openBtn.focus();
    });
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => drawer.close()));
    drawer.querySelectorAll<HTMLButtonElement>('[data-drawer-expand]').forEach((button) => {
      const list = document.getElementById(button.getAttribute('aria-controls') ?? '');
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        if (list) list.hidden = !open;
      });
    });
  }
</script>
