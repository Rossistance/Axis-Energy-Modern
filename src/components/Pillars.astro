---
import { Icon } from 'astro-icon/components';
import { pillars } from '@data/pillars';

interface Props {
  teaser?: boolean;
}

const { teaser = false } = Astro.props;
const firstSentence = (s: string) => s.split(/(?<=\.)\s/)[0];
---

<div class:list={['grid', teaser ? 'grid--3' : 'grid--3', 'pillars']} data-reveal-group>
  {pillars.map((p) => (
    <article class="card card--lift pillar">
      <div class="icon-tile">
        <Icon name={p.icon} />
      </div>
      <h3>{p.title}</h3>
      <p>{teaser ? firstSentence(p.body) : p.body}</p>
    </article>
  ))}
</div>

<style>
  .pillar h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .pillar p {
    color: var(--text-muted);
    font-size: 0.98rem;
  }
</style>
