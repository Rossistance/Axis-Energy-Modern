---
/**
 * Home page band under the hero (3 P's update, approved by the owner 2026-11-02). Since
 * 2026-11-20 the owner's pain, Axis's purpose and the promise read as one passage, with no
 * labels, beside three projects where Axis closed the gap (owner, 2026-11-20). Sources for the
 * pain points are listed in the strategy update's sources document (EPC wind-downs, the 2027
 * placed-in-service deadline for solar under 48E/45Y, and fleet under-production versus
 * estimates).
 */
import { Icon } from 'astro-icon/components';
import { href } from '@lib/href';
import { company } from '@data/company';

const projects = [
  {
    href: '/project/hertford-solar/',
    title: 'Hertford Solar',
    body: 'Another EPC left it at clearing and grading. We carried all 13.97 MWdc to interconnection.',
  },
  {
    href: '/project/yadkinville-solar/',
    title: 'Yadkinville rebuild',
    body: 'A storm-damaged 4.8 MWdc plant, demolished, rebuilt and returned to service.',
  },
  {
    href: '/project/cooperative-solar-storage-portfolio/',
    title: 'NCEMC portfolio',
    body: 'Five solar + storage sites with 22.6 MWh of Tesla storage, built by Axis and still maintained by Axis O&M.',
  },
];
---

<section class="section three-ps" id="your-risk" aria-labelledby="three-ps-title">
  <div class="container three-ps__layout">
    <div class="three-ps__story" data-reveal>
      <p class="eyebrow">One team, start to finish</p>
      <h2 id="three-ps-title">Energy projects fail in the gaps. We close them.</h2>
      <p class="lead">
        Projects rarely fail all at once. They lose ground at the hand-offs: a contractor exits
        mid-build and leaves permits, crews and schedules in limbo, or a finished plant quietly
        produces less than its estimate and no one owns the fix. The calendar no longer forgives
        delay, either. Solar that missed the July 4, 2026 construction start must be in service by
        December 31, 2027 to keep the federal credit.
      </p>
      <p>
        That is the work Axis was built for. One employee-owned team engineers, builds, energizes
        and maintains your system, so there is no hand-off for a schedule to slip through. Our
        electrical roots go back to 1910, and 1910 Legacy Enterprises stands behind every contract.
      </p>
      <p>
        What you get is a plant that is built right, energized on schedule and still performing
        years later. We put that in writing as seven commitments, from a named project lead to a
        response to every request {company.responseTime}.
      </p>
      <a class="link-arrow" href={href('/why-axis/#promise')}>
        See the seven commitments <Icon name="lucide:arrow-right" class="icon" />
      </a>
    </div>

    <div class="three-ps__work" data-reveal>
      <h3 id="three-ps-work-title">Gaps we have closed</h3>
      <ul class="three-ps__projects" aria-labelledby="three-ps-work-title" data-reveal-group>
        {projects.map((p) => (
          <li>
            <a href={href(p.href)}>
              <strong>{p.title}</strong>
              <span>{p.body}</span>
              <Icon name="lucide:arrow-right" class="three-ps__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .three-ps__layout {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .three-ps__layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .three-ps__story h2 {
    margin-bottom: 0.9rem;
  }

  .three-ps__story p {
    max-width: 62ch;
  }

  .three-ps__story p:not(.eyebrow):not(.lead) {
    color: var(--text-muted);
  }

  .three-ps__story .link-arrow {
    display: inline-flex;
    margin-top: 0.25rem;
  }

  .three-ps__work h3 {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }

  @media (min-width: 900px) {
    /* Sit the project list level with the passage, below the eyebrow. */
    .three-ps__work {
      padding-top: 2.25rem;
    }
  }

  .three-ps__projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .three-ps__projects a {
    position: relative;
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 0.9rem 2.5rem 0.9rem 1rem;
    border: 1px solid var(--line);
    border-left: 4px solid var(--brand-green);
    border-radius: var(--r-md, 12px);
    color: var(--text);
    text-decoration: none;
    background: var(--surface-alt, #f5f8fa);
  }

  .three-ps__projects a:hover strong {
    text-decoration: underline;
  }

  .three-ps__projects span {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .three-ps__projects :global(.three-ps__arrow) {
    position: absolute;
    right: 1rem;
    top: 50%;
    width: 18px;
    height: 18px;
    transform: translateY(-50%);
    color: var(--brand-green);
  }
</style>
