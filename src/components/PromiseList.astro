---
/** The seven commitments on Why Axis (src/data/promise.ts); each body carries its own proof. */
import { Icon } from 'astro-icon/components';
import { commitments } from '@data/promise';
import { href } from '@lib/href';
---

<ol class="promise-list" data-reveal-group>
  {commitments.map((c, i) => (
    <li class="card promise-item">
      <div class="promise-item__head">
        <span class="promise-item__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="icon-tile promise-item__icon">
          <Icon name={c.icon} />
        </span>
      </div>
      <h3>{c.title}</h3>
      <p>{c.body}</p>
      {c.link && (
        <a class="link-arrow promise-item__link" href={href(c.link.href)}>
          {c.link.label} <Icon name="lucide:arrow-right" class="icon" />
        </a>
      )}
    </li>
  ))}
</ol>

<style>
  .promise-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 720px) {
    .promise-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .promise-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .promise-item:nth-child(n + 5) {
      grid-column: span 1;
    }

    .promise-item:last-child {
      grid-column: span 2;
    }
  }

  .promise-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 4px solid var(--brand-green);
  }

  .promise-item__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .promise-item__num {
    font-family: var(--font-display, inherit);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--brand-navy);
    opacity: 0.25;
  }

  .promise-item h3 {
    font-size: 1.12rem;
    margin: 0.2rem 0 0;
  }

  .promise-item p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .promise-item__link {
    display: inline-flex;
    align-self: start;
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: 0.9rem;
  }
</style>
