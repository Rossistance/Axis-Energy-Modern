---
/**
 * Home page headline as the owner's diagram (2026-10-01): "The Power of Partnership", the
 * three things Axis builds, "Performance built for" and the four markets it serves. The
 * services link to their service pages and each market card to its section of the Markets
 * page.
 *
 * The branches are SVG curves fanning out from one node under "for" to a chevron above each
 * card; when the column is narrow the cards sit two by two, the top pair fed by the curves
 * and each bottom card by a short arrow from the card above it (owner, 2026-10-01). The SVGs
 * stretch to the width of the cards (x in percent, y in rem), so every size below is shared
 * with the CSS. Four across needs a column of 420 px or more; narrower columns use the
 * two-by-two grid.
 */
import { projectMarkets, marketPath } from '@data/project-markets';
import { servicePath } from '@data/services';
import { href } from '@lib/href';

const services = [
  { label: 'Solar', href: servicePath('solar-epc') },
  { label: 'Battery Storage', href: servicePath('battery-storage-and-microgrids') },
  { label: 'Microgrids', href: servicePath('battery-storage-and-microgrids') },
];

/** "Electric Co-ops & Utilities" → ["Electric Co-ops", "Utilities"], set on separate lines. */
const markets = projectMarkets.map((m) => ({
  parts: (m.shortTitle ?? m.title).split(' & '),
  href: marketPath(m.id),
}));

// Sizes in rem, shared by the CSS (custom properties) and the SVG coordinates.
const FAN = 2.6; // height of the fan above the row of four
const FAN_NARROW = 2.3; // height of the fan above the two-by-two grid
const CARD = 3.6; // card height
const ROW_GAP = 1.5; // gap between the two rows, room for the arrow joining them
const TIP = 0.36; // the curves stop this far above a card, inside its chevron

// Four across with a 4 % gap: the cards' centres sit at 11, 37, 63 and 89 % of the width.
const rowPaths = [11, 37, 63, 89].map(
  (x) => `M50 0 C50 ${FAN * 0.62} ${x} ${FAN * 0.3} ${x} ${FAN - TIP}`,
);

// Two by two with a 14 % gap: the top cards' centres sit at 21.5 and 78.5 %. The bottom
// cards hang from the cards above them (CSS arrows), so only the top pair needs curves.
const gridPaths = [21.5, 78.5].map(
  (x) => `M50 0 C50 ${FAN_NARROW * 0.62} ${x} ${FAN_NARROW * 0.3} ${x} ${FAN_NARROW - TIP}`,
);
const vars = `--fan: ${FAN}rem; --fan-narrow: ${FAN_NARROW}rem; --card-h: ${CARD}rem; --row-gap: ${ROW_GAP}rem; --tip: ${TIP}rem`;
---

<div class="partnership" style={vars}>
  <h1 id="hero-title" class="partnership__title">
    The Power of Partnership
  </h1>

  <ul class="partnership__services" aria-label="What we build">
    {services.map((s) => (
      <li>
        <a href={href(s.href)}>{s.label}</a>
      </li>
    ))}
  </ul>

  <p class="partnership__built">Performance built</p>
  <p class="partnership__for">for</p>

  <div class="partnership__branch">
    <svg
      class="partnership__fan partnership__fan--row"
      viewBox={`0 0 100 ${FAN}`}
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient
          id="fan-row-stroke"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="0"
          x2="0"
          y2={FAN}
        >
          <stop offset="0" stop-color="#9eede6" />
          <stop offset="1" stop-color="#5fd39a" />
        </linearGradient>
      </defs>
      {rowPaths.map((d) => (
        <path d={d} stroke="url(#fan-row-stroke)" />
      ))}
    </svg>
    <svg
      class="partnership__fan partnership__fan--grid"
      viewBox={`0 0 100 ${FAN_NARROW}`}
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient
          id="fan-grid-stroke"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="0"
          x2="0"
          y2={FAN_NARROW}
        >
          <stop offset="0" stop-color="#9eede6" />
          <stop offset="1" stop-color="#5fd39a" />
        </linearGradient>
      </defs>
      {gridPaths.map((d) => (
        <path d={d} stroke="url(#fan-grid-stroke)" />
      ))}
    </svg>

    <ul class="partnership__markets" aria-label="Markets we serve">
      {markets.map((m) => (
        <li>
          <a href={href(m.href)}>
            {m.parts.map((part, i) => (
              <>
                {i > 0 && <span class="partnership__amp"> & </span>}
                <span class="partnership__part">{part}</span>
              </>
            ))}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .partnership {
    --chevron: var(--brand-green-bright);
    container-type: inline-size;
    text-align: center;
  }

  .partnership__title {
    max-width: 14ch;
    margin: 0 auto;
    color: #fff;
    font-size: clamp(2.3rem, 1.4rem + 3vw, 3.6rem);
    line-height: 1.05;
  }

  /* SOLAR | BATTERY STORAGE | MICROGRIDS */
  .partnership__services {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: clamp(1rem, 2.4vw, 1.4rem) 0 0;
    padding: 0;
  }

  .partnership__services li {
    padding: 0.15rem clamp(0.7rem, 2.2cqi, 1.3rem);
    border-left: 1px solid rgba(255, 255, 255, 0.35);
  }

  .partnership__services li:last-child {
    border-right: 1px solid rgba(255, 255, 255, 0.35);
  }

  .partnership__services a {
    display: inline-block;
    padding-block: 0.3rem;
    color: #fff;
    font-size: clamp(0.78rem, 0.7rem + 0.35vw, 0.92rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: rgba(158, 237, 230, 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition:
      color var(--dur-1, 150ms) ease,
      text-decoration-color var(--dur-1, 150ms) ease;
  }

  .partnership__services a:hover {
    color: var(--aqua-200);
    text-decoration-color: var(--aqua-400);
  }

  /* PERFORMANCE BUILT, between two rules that fade at the ends. */
  .partnership__built {
    display: inline-block;
    margin: clamp(1.1rem, 2.6vw, 1.5rem) 0 0;
    padding: 0.6rem clamp(1.25rem, 5cqi, 2.25rem);
    border-block: 2px solid transparent;
    border-image: linear-gradient(
        90deg,
        transparent,
        var(--aqua-400) 18%,
        var(--brand-green-bright) 82%,
        transparent
      )
      1;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .partnership__for {
    margin: 0.8rem 0 0;
    color: var(--aqua-200);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  /* The fan and the cards, centred and narrower than the column. */
  .partnership__branch {
    position: relative;
    width: min(100%, 30rem);
    margin: 0.55rem auto 0;
  }

  /* The node the branches leave from. */
  .partnership__branch::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--aqua-200);
    box-shadow: 0 0 0 4px rgba(63, 207, 196, 0.18);
    transform: translate(-50%, -50%);
  }

  .partnership__fan {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    overflow: visible;
    pointer-events: none;
    filter: drop-shadow(0 0 3px rgba(63, 207, 196, 0.35));
  }

  .partnership__fan--row {
    height: var(--fan);
  }

  .partnership__fan--grid {
    display: none;
    height: var(--fan-narrow);
  }

  .partnership__fan path {
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* Four across: cards at 22 % with 4 % gaps, so their centres match the curves. */
  .partnership__markets {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: var(--card-h);
    column-gap: 4%;
    margin: 0;
    padding: var(--fan) 0 0;
  }

  .partnership__markets li {
    position: relative;
    display: flex;
  }

  /* Chevron above each card, where its curve ends. */
  .partnership__markets li::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -9.5px;
    width: 7px;
    height: 7px;
    border-right: 1.6px solid var(--chevron);
    border-bottom: 1.6px solid var(--chevron);
    transform: translateX(-50%) rotate(45deg);
  }

  .partnership__markets a {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: 0.35rem 0.2rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 8px 18px -12px rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: clamp(0.7rem, 2.65cqi, 0.78rem);
    font-weight: 600;
    line-height: 1.15;
    text-decoration: none;
    transition:
      transform var(--dur-1, 150ms) ease,
      background-color var(--dur-1, 150ms) ease,
      border-color var(--dur-1, 150ms) ease;
  }

  .partnership__markets a:hover {
    background: rgba(255, 255, 255, 0.13);
    border-color: var(--aqua-400);
    transform: translateY(-2px);
  }

  .partnership__amp {
    color: var(--aqua-400);
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* Narrow column (phones, and desktops where the photos take most of the width): two by
     two; each bottom card is joined to the card above it by a short arrow. */
  @container (max-width: 419px) {
    .partnership__branch {
      width: min(100%, 22rem);
    }

    .partnership__fan--row {
      display: none;
    }

    .partnership__fan--grid {
      display: block;
    }

    .partnership__markets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 14%;
      row-gap: var(--row-gap);
      padding-top: var(--fan-narrow);
    }

    .partnership__markets a {
      font-size: 0.8rem;
    }

    /* The arrow's shaft, from the bottom of a top card down to the chevron above the card
       below it (the chevrons are the same as the ones the curves end in). */
    .partnership__markets li:nth-child(-n + 2)::after {
      content: '';
      position: absolute;
      left: 50%;
      top: calc(100% + 3px);
      width: 1.6px;
      height: calc(var(--row-gap) - 9px);
      border-radius: 1px;
      background: linear-gradient(var(--aqua-200), var(--chevron));
      box-shadow: 0 0 4px rgba(63, 207, 196, 0.35);
      transform: translateX(-50%);
    }
  }

  /* Phones: keep SOLAR | BATTERY STORAGE | MICROGRIDS on one line. */
  @container (max-width: 419px) {
    .partnership__services li {
      padding-inline: 0.55rem;
    }

    .partnership__services a {
      font-size: 0.74rem;
      letter-spacing: 0.08em;
    }
  }

  /* The branches grow down from the node when the page opens. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .partnership__fan {
      animation: fan-grow 0.8s var(--ease-out) 0.15s both;
    }

    :global(html.js) .partnership__markets li::before,
    :global(html.js) .partnership__markets li::after {
      animation: fan-tip 0.35s ease 0.75s both;
    }
  }

  @keyframes fan-grow {
    from {
      clip-path: inset(0 0 100% 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  @keyframes fan-tip {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
