---
/**
 * Home page headline as the owner's diagram (2026-10-01): "The Power of Partnership", the
 * three things Axis builds, "Performance built for" and the four markets it serves. The
 * services link to their service pages and each market box to its section of the Markets
 * page. The connector lines are drawn in CSS: one stem branching to four boxes in a row,
 * or, when the column is narrow, a centre spine feeding a two-by-two grid.
 */
import { projectMarkets, marketPath } from '@data/project-markets';
import { servicePath } from '@data/services';
import { href } from '@lib/href';

const services = [
  { label: 'Solar', href: servicePath('solar-epc') },
  { label: 'Battery Storage', href: servicePath('battery-storage-and-microgrids') },
  { label: 'Microgrids', href: servicePath('battery-storage-and-microgrids') },
];

/** "Electric Co-ops & Utilities" → ["Electric Co-ops", "Utilities"], set on separate lines. */
const markets = projectMarkets.map((m) => ({
  parts: (m.shortTitle ?? m.title).split(' & '),
  href: marketPath(m.id),
}));
---

<div class="partnership">
  <h1 id="hero-title" class="partnership__title">
    The Power of Partnership
  </h1>

  <ul class="partnership__services" aria-label="What we build">
    {services.map((s) => (
      <li>
        <a href={href(s.href)}>{s.label}</a>
      </li>
    ))}
  </ul>

  <p class="partnership__built">Performance built</p>
  <p class="partnership__for">for</p>

  <ul class="partnership__markets" aria-label="Markets we serve">
    {markets.map((m) => (
      <li>
        <a href={href(m.href)}>
          {m.parts.map((part, i) => (
            <>
              {i > 0 && <span class="partnership__amp"> & </span>}
              <span class="partnership__part">{part}</span>
            </>
          ))}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .partnership {
    --line-color: rgba(158, 237, 230, 0.55);
    --line-w: 1.5px;
    --drop: 30px;
    --gap: 0.75rem;
    /* Two-by-two layout: room between the columns for the spine and its arrows. */
    --spine-gap: 2.75rem;
    container-type: inline-size;
    text-align: center;
  }

  .partnership__title {
    max-width: 14ch;
    margin: 0 auto;
    color: #fff;
    font-size: clamp(2.3rem, 1.4rem + 3vw, 3.6rem);
    line-height: 1.05;
  }

  /* SOLAR | BATTERY STORAGE | MICROGRIDS */
  .partnership__services {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: clamp(1rem, 2.4vw, 1.4rem) 0 0;
    padding: 0;
  }

  .partnership__services li {
    padding: 0.15rem clamp(0.7rem, 2.2cqi, 1.3rem);
    border-left: 1px solid rgba(255, 255, 255, 0.35);
  }

  .partnership__services li:last-child {
    border-right: 1px solid rgba(255, 255, 255, 0.35);
  }

  .partnership__services a {
    display: inline-block;
    padding-block: 0.3rem;
    color: #fff;
    font-size: clamp(0.78rem, 0.7rem + 0.35vw, 0.92rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: rgba(158, 237, 230, 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition:
      color var(--dur-1, 150ms) ease,
      text-decoration-color var(--dur-1, 150ms) ease;
  }

  .partnership__services a:hover {
    color: var(--aqua-200);
    text-decoration-color: var(--aqua-400);
  }

  /* PERFORMANCE BUILT, between two rules that fade at the ends. */
  .partnership__built {
    display: inline-block;
    margin: clamp(1.1rem, 2.6vw, 1.5rem) 0 0;
    padding: 0.6rem clamp(1.25rem, 5cqi, 2.25rem);
    border-block: 2px solid transparent;
    border-image: linear-gradient(
        90deg,
        transparent,
        var(--aqua-400) 18%,
        var(--brand-green-bright) 82%,
        transparent
      )
      1;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* FOR, with the stem that feeds the market boxes. */
  .partnership__for {
    position: relative;
    margin: 0.85rem 0 0;
    padding-bottom: 16px;
    color: var(--aqua-200);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .partnership__for::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: var(--line-w);
    height: 12px;
    background: var(--line-color);
    transform: translateX(-50%);
  }

  /* Four boxes in a row: a bar across their centres and a drop with an arrow into each. */
  .partnership__markets {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    padding: var(--drop) 0 0;
  }

  .partnership__markets::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc((100% - 3 * var(--gap)) / 8);
    right: calc((100% - 3 * var(--gap)) / 8);
    height: var(--line-w);
    background: var(--line-color);
  }

  .partnership__markets li {
    position: relative;
    display: flex;
  }

  .partnership__markets li::before,
  .partnership__markets li::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .partnership__markets li::before {
    top: calc(-1 * var(--drop));
    width: var(--line-w);
    height: calc(var(--drop) - 7px);
    background: var(--line-color);
  }

  .partnership__markets li::after {
    top: -7px;
    border-inline: 5px solid transparent;
    border-top: 7px solid var(--aqua-400);
  }

  .partnership__markets a {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    min-height: 88px;
    padding: 0.75rem 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: clamp(0.8rem, 2.6cqi, 0.95rem);
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    text-wrap: balance;
    transition:
      transform var(--dur-1, 150ms) ease,
      background-color var(--dur-1, 150ms) ease,
      border-color var(--dur-1, 150ms) ease;
  }

  .partnership__markets a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--aqua-400);
    transform: translateY(-2px);
  }

  .partnership__amp {
    color: var(--aqua-400);
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* Narrow column (phones, and desktops where the photos take most of the width): a centre
     spine feeds two boxes on each side, with an arrow into each. */
  @container (max-width: 499px) {
    .partnership__markets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      column-gap: var(--spine-gap);
      row-gap: var(--gap);
      padding-top: 0;
    }

    .partnership__markets::before {
      top: 0;
      bottom: calc((100% - var(--gap)) / 4);
      left: 50%;
      right: auto;
      width: var(--line-w);
      height: auto;
      transform: translateX(-50%);
    }

    .partnership__markets li::before {
      top: 50%;
      left: 100%;
      width: calc(var(--spine-gap) / 2 - 7px);
      height: var(--line-w);
      transform: translate(7px, -50%);
    }

    .partnership__markets li::after {
      top: 50%;
      left: 100%;
      border-inline: 0;
      border-block: 5px solid transparent;
      border-right: 7px solid var(--aqua-400);
      transform: translate(0, -50%);
    }

    .partnership__markets li:nth-child(even)::before {
      left: auto;
      right: 100%;
      transform: translate(-7px, -50%);
    }

    .partnership__markets li:nth-child(even)::after {
      left: auto;
      right: 100%;
      border-right: 0;
      border-left: 7px solid var(--aqua-400);
    }

    .partnership__markets a {
      min-height: 72px;
      font-size: 0.9rem;
    }
  }

  /* Phones: keep SOLAR | BATTERY STORAGE | MICROGRIDS on one line. */
  @container (max-width: 419px) {
    .partnership__services li {
      padding-inline: 0.55rem;
    }

    .partnership__services a {
      font-size: 0.74rem;
      letter-spacing: 0.08em;
    }
  }
</style>
