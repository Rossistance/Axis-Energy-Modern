---
import { Icon } from 'astro-icon/components';
import { markets } from '@data/services';
---

<ul class="markets" data-reveal-group>
  {markets.map((m) => (
    <li class="market">
      <div class="icon-tile">
        <Icon name={m.icon} />
      </div>
      <h3>{m.title}</h3>
      <p>{m.body}</p>
    </li>
  ))}
</ul>

<style>
  .markets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .market {
    padding: 1.35rem;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .market .icon-tile {
    margin-bottom: 0.9rem;
  }

  .market h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .market p {
    font-size: 0.92rem;
    color: var(--text-muted);
  }
</style>
