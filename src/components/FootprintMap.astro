---
/**
 * Home page footprint map: headquarters pin, the O&M and technical services states, the
 * project footprint (every state in the lower 48) and an unlabelled white push pin at every
 * town where Axis has completed a project. Pins are decorative: no links, names or details.
 *
 * State shapes come from src/data/us-map.ts (generated by scripts/make-us-map.mjs); pins are
 * placed with the same Albers USA projection, so both line up exactly.
 */
import { getCollection } from 'astro:content';
import { geoAlbersUsa } from 'd3-geo';
import { US_MAP, US_STATES } from '@data/us-map';
import { company } from '@data/company';
import { stateName } from '@lib/format';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
}

const omStates: readonly string[] = company.omStates;
const omNames = omStates.map(stateName);
const omList = `${omNames.slice(0, -1).join(', ')} and ${omNames[omNames.length - 1]}`;

const {
  eyebrow = 'Where we work',
  title = 'Projects nationwide. O&M close to home.',
  lead = `From our headquarters in Holly Springs, North Carolina, Axis Energy builds solar, battery storage and microgrid projects across the lower 48 states. Our O&M and technical services teams support owners in ${omList}.`,
} = Astro.props;

const projection = geoAlbersUsa().scale(US_MAP.scale).translate(US_MAP.translate);
const OUTSIDE = new Set(['AK', 'HI']);
const stateClass = (id: string) =>
  omStates.includes(id) ? 'is-om' : OUTSIDE.has(id) ? 'is-outside' : 'is-project';

const [hqX, hqY] = projection([company.address.geo.lng, company.address.geo.lat])!;

// One pin per town (several projects can share one), none on top of the headquarters pin,
// drawn north to south so nearer pins overlap the ones behind them.
const pins: [number, number][] = [];
for (const project of await getCollection('projects')) {
  const c = project.data.coordinates;
  const xy = c && projection([c.lon, c.lat]);
  if (!xy) continue;
  const [x, y] = xy;
  if (Math.hypot(x - hqX, y - hqY) < 6) continue;
  if (pins.some(([px, py]) => Math.hypot(px - x, py - y) < 5)) continue;
  pins.push([x, y]);
}
pins.sort((a, b) => a[1] - b[1]);

const fmt = (n: number) => n.toFixed(1);
// Callout for the headquarters pin, set in the Atlantic south-east of North Carolina.
const label = { x: 850, y: 404 };
---

<section class="section footprint" aria-labelledby="footprint-title">
  <div class="container">
    <div class="footprint__head">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="footprint-title">{title}</h2>
      </div>
      <p class="lead">{lead}</p>
    </div>

    <div class="footprint__body">
      <figure class="footprint__figure" data-reveal>
        <svg
          class="footprint__map"
          viewBox={`0 0 ${US_MAP.width} ${US_MAP.height}`}
          role="img"
          aria-labelledby="footprint-map-title footprint-map-desc"
        >
          <title id="footprint-map-title">Axis Energy footprint map</title>
          <desc id="footprint-map-desc">
            {`Map of the United States. Headquarters pin in Holly Springs, North Carolina. ${omList} are shaded as the operations and maintenance footprint. Every other state in the lower 48 is shaded as the project footprint. Pins mark ${pins.length} towns where Axis has completed projects.`}
          </desc>
          <defs>
            <radialGradient id="fp-head" cx="0.38" cy="0.32" r="0.75">
              <stop offset="0" stop-color="#ffffff"></stop>
              <stop offset="0.55" stop-color="#eef2f7"></stop>
              <stop offset="1" stop-color="#b7c3d1"></stop>
            </radialGradient>
            <linearGradient id="fp-hq-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#1b5ea6"></stop>
              <stop offset="1" stop-color="#002352"></stop>
            </linearGradient>
            <radialGradient id="fp-shadow">
              <stop offset="0" stop-color="#0b2440" stop-opacity="0.5"></stop>
              <stop offset="1" stop-color="#0b2440" stop-opacity="0"></stop>
            </radialGradient>

            <!-- Push pin: round white head on a short needle; the tip is at 0,0. -->
            <g id="fp-pin">
              <ellipse cx="0" cy="0" rx="4.6" ry="1.7" fill="url(#fp-shadow)"></ellipse>
              <path
                d="M0 -0.3 L0 -9"
                stroke="#34404d"
                stroke-width="1.3"
                stroke-linecap="round"
              ></path>
              <circle
                cx="0"
                cy="-13.2"
                r="5.4"
                fill="url(#fp-head)"
                stroke="#0b2440"
                stroke-opacity="0.5"
                stroke-width="0.8"
              ></circle>
              <ellipse cx="-1.8" cy="-15.1" rx="1.6" ry="1.05" fill="#fff"></ellipse>
            </g>
          </defs>

          <g class="footprint__states">
            {US_STATES.map((s) => (
              <path d={s.d} class={stateClass(s.id)} />
            ))}
          </g>

          <g class="footprint__pins" aria-hidden="true">
            {pins.map(([x, y], i) => (
              <g transform={`translate(${fmt(x)} ${fmt(y)})`}>
                <g class="fp-scale">
                  <g class="fp-drop" style={`--i: ${i}`}>
                    <use href="#fp-pin" />
                  </g>
                </g>
              </g>
            ))}
          </g>

          <g class="footprint__hq" aria-hidden="true">
            <path
              class="footprint__leader"
              d={`M${fmt(hqX + 3)} ${fmt(hqY + 2)} Q ${fmt(hqX + 34)} ${fmt(hqY + 8)} ${label.x - 4} ${label.y - 14}`}
            ></path>
            <g class="footprint__label">
              <text x={label.x} y={label.y - 4} class="footprint__label-name">
                Holly Springs, NC
              </text>
              <text x={label.x} y={label.y + 12} class="footprint__label-role">
                HEADQUARTERS
              </text>
            </g>
            <g transform={`translate(${fmt(hqX)} ${fmt(hqY)})`}>
              <g class="fp-scale">
                <circle class="footprint__pulse" r="9"></circle>
                <ellipse cx="0" cy="0" rx="8" ry="2.8" fill="url(#fp-shadow)"></ellipse>
                <path
                  d="M0 0 C-2.6 -7.2 -11 -12.4 -11 -21.5 A11 11 0 1 1 11 -21.5 C11 -12.4 2.6 -7.2 0 0 Z"
                  fill="url(#fp-hq-fill)"
                  stroke="#fff"
                  stroke-width="1.8"
                ></path>
                <circle cx="0" cy="-21.5" r="5.6" fill="#fff"></circle>
                <circle cx="0" cy="-21.5" r="3" fill="#00a466"></circle>
              </g>
            </g>
          </g>
        </svg>
      </figure>

      <ul class="footprint__legend" aria-label="Map key">
        <li>
          <svg class="footprint__key-hq" viewBox="-12 -36 24 40" aria-hidden="true">
            <path d="M0 0 C-2.6 -7.2 -11 -12.4 -11 -21.5 A11 11 0 1 1 11 -21.5 C11 -12.4 2.6 -7.2 0 0 Z"></path>
            <circle cx="0" cy="-21.5" r="5.6" fill="#fff"></circle>
            <circle cx="0" cy="-21.5" r="3" class="dot"></circle>
          </svg>
          <span>
            <strong>Headquarters</strong> Holly Springs, North Carolina
          </span>
        </li>
        <li>
          <span class="footprint__swatch is-om" aria-hidden="true"></span>
          <span>
            <strong>O&M and technical services</strong> {omList}
          </span>
        </li>
        <li>
          <span class="footprint__swatch is-project" aria-hidden="true"></span>
          <span>
            <strong>Project footprint</strong> Solar, storage and microgrids in all lower 48 states
          </span>
        </li>
        <li>
          <svg class="footprint__key-pin" viewBox="-8 -21 16 24" aria-hidden="true">
            <use href="#fp-pin"></use>
          </svg>
          <span>
            <strong>Projects we have built</strong> Each pin marks a town with a completed Axis
            project
          </span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .footprint {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    --fp-project: #3b7dc4;
    --fp-om: #008752;
    --fp-outside: #dfe5ec;
  }

  .footprint__head {
    display: grid;
    gap: 0.75rem 3rem;
    align-items: end;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .footprint__head h2 {
    margin: 0;
    max-width: 16ch;
  }

  .footprint__head .lead {
    margin: 0;
    max-width: 62ch;
  }

  .footprint__body {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }

  .footprint__figure {
    margin: 0;
  }

  .footprint__map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 14px 22px rgba(0, 35, 82, 0.14));
  }

  .footprint__states path {
    stroke: #fff;
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  .footprint__states .is-project {
    fill: var(--fp-project);
  }

  .footprint__states .is-om {
    fill: var(--fp-om);
  }

  .footprint__states .is-outside {
    fill: var(--fp-outside);
  }

  .footprint__leader {
    fill: none;
    stroke: var(--brand-navy);
    stroke-width: 1.2;
  }

  .footprint__label-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13.5px;
    fill: var(--brand-navy);
  }

  .footprint__label-role {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    fill: var(--brand-green-dark);
  }

  .footprint__pulse {
    fill: none;
    stroke: var(--brand-navy);
    stroke-width: 1.2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .footprint__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem 2rem;
  }

  .footprint__legend li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 0.85rem;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.45;
  }

  .footprint__legend strong {
    display: block;
    color: var(--text);
    font-size: 0.95rem;
  }

  .footprint__swatch {
    width: 26px;
    height: 18px;
    border-radius: 5px;
    box-shadow: inset 0 0 0 1px rgba(0, 35, 82, 0.12);
  }

  .footprint__swatch.is-om {
    background: var(--fp-om);
  }

  .footprint__swatch.is-project {
    background: var(--fp-project);
  }

  .footprint__key-hq,
  .footprint__key-pin {
    width: 26px;
    height: 32px;
    justify-self: center;
  }

  .footprint__key-hq path {
    fill: var(--brand-navy);
    stroke: #fff;
    stroke-width: 1.8;
  }

  .footprint__key-hq .dot {
    fill: #00a466;
  }

  /* Pins are drawn at map scale and enlarged so they stay easy to see, most on phones. */
  .fp-scale {
    transform: scale(1.25);
  }

  @media (max-width: 639px) {
    .fp-scale {
      transform: scale(1.9);
    }

    .footprint__leader,
    .footprint__label {
      display: none;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .footprint__legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .footprint__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .footprint__body {
      grid-template-columns: minmax(0, 8.5fr) minmax(0, 3.5fr);
    }
  }

  /* Motion is additive: pins are in place without JavaScript or with reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .footprint__figure .fp-drop {
      opacity: 0;
      transform: translateY(-14px);
    }

    :global(html.js) .footprint__figure.is-visible .fp-drop {
      animation: fp-drop 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(250ms + var(--i) * 28ms);
    }

    :global(html.js) .footprint__figure.is-visible .footprint__pulse {
      animation: fp-pulse 2.8s ease-out 1.2s infinite;
    }
  }

  @keyframes fp-drop {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fp-pulse {
    0% {
      opacity: 0.55;
      transform: scale(0.6);
    }

    100% {
      opacity: 0;
      transform: scale(2.6);
    }
  }
</style>
