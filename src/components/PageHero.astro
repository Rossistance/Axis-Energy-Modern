---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  art?: ImageMetadata;
  /** CSS object-position for the art crop, e.g. "right 20%". */
  artPosition?: string;
  /** Zoom factor for derived crops. */
  artScale?: number;
  light?: boolean;
  compact?: boolean;
  crumbs?: { label: string; href: string }[];
  /** Aspect ratio of the art panel on desktop. */
  ratio?: string;
}

const {
  eyebrow,
  title,
  lead,
  art,
  artPosition = 'center',
  artScale = 1,
  light = false,
  compact = false,
  crumbs,
  ratio = '4 / 3',
} = Astro.props;
---

<section
  class:list={[
    'page-hero',
    light ? 'band-light' : 'band-dark',
    { 'page-hero--compact': compact, 'page-hero--no-art': !art },
  ]}
  aria-labelledby="page-title"
>
  <div class="container">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <div class="page-hero__grid">
      <div class="page-hero__copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 id="page-title">{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
      {art && (
        <div
          class="page-hero__art"
          style={`--ratio: ${ratio}; --pos: ${artPosition}; --scale: ${artScale};`}
        >
          <Picture
            src={art}
            alt=""
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .page-hero--compact {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(2rem, 4vw, 3rem);
  }

  .page-hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .page-hero__copy h1 {
    font-size: var(--h1-sm);
    max-width: 18ch;
  }

  .band-dark .page-hero__copy h1 {
    color: #fff;
  }

  .page-hero__copy .lead {
    max-width: 56ch;
  }

  .page-hero__art {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--shadow-3);
    isolation: isolate;
  }

  .page-hero__art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    pointer-events: none;
  }

  .band-light .page-hero__art::before {
    box-shadow: inset 0 0 0 1px rgba(0, 35, 82, 0.1);
  }

  .page-hero__art :global(picture) {
    position: absolute;
    inset: 0;
  }

  .page-hero__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
    transform: scale(var(--scale));
    transform-origin: var(--pos);
  }

  @media (min-width: 1024px) {
    .page-hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .page-hero--no-art .page-hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .page-hero__art {
      aspect-ratio: var(--ratio);
      max-height: 440px;
      justify-self: end;
      width: 100%;
    }
  }
</style>
