---
/**
 * Inner-page header. Kept compact so the page's real content shows without scrolling: the
 * illustration is a slim panel that takes its height from the text on desktop and is left
 * out on phones and tablets.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  art?: ImageMetadata;
  /** CSS object-position for the art crop, e.g. "right 20%". */
  artPosition?: string;
  /** Zoom factor for derived crops. */
  artScale?: number;
  light?: boolean;
  compact?: boolean;
  crumbs?: { label: string; href: string }[];
}

const {
  eyebrow,
  title,
  lead,
  art,
  artPosition = 'center',
  artScale = 1,
  light = false,
  compact = false,
  crumbs,
} = Astro.props;
---

<section
  class:list={[
    'page-hero',
    light ? 'band-light' : 'band-dark',
    { 'page-hero--compact': compact, 'page-hero--no-art': !art },
  ]}
  aria-labelledby="page-title"
>
  <div class="container">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <div class="page-hero__grid">
      <div class="page-hero__copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 id="page-title">{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
      {art && (
        <div class="page-hero__art" style={`--pos: ${artPosition}; --scale: ${artScale};`}>
          <Picture
            src={art}
            alt=""
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[400, 640, 800]}
            sizes="380px"
            loading="lazy"
            decoding="async"
          />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--page-hero-pad-top) var(--page-hero-pad-bottom);
  }

  .page-hero--compact {
    padding-block: clamp(0.9rem, 1.8vw, 1.25rem) clamp(1.2rem, 2.4vw, 1.75rem);
  }

  .page-hero__grid {
    display: grid;
    gap: 1.5rem 3rem;
  }

  .page-hero__copy {
    align-self: center;
  }

  .page-hero__copy .eyebrow {
    margin-bottom: 0.55rem;
  }

  .page-hero__copy h1 {
    font-size: var(--h1-page);
    max-width: 24ch;
    margin: 0;
  }

  .band-dark .page-hero__copy h1 {
    color: #fff;
  }

  .page-hero__copy .lead {
    max-width: 64ch;
    margin: 0.6rem 0 0;
    font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.15rem);
  }

  .page-hero__copy :global(.page-hero__actions) {
    margin-top: 1.1rem;
  }

  .page-hero__art {
    display: none;
  }

  @media (min-width: 1024px) {
    .page-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
      align-items: stretch;
    }

    .page-hero--no-art .page-hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .page-hero__art {
      display: block;
      position: relative;
      min-height: 180px;
      max-height: 260px;
      align-self: center;
      height: 100%;
      border-radius: var(--r-lg);
      overflow: hidden;
      box-shadow: var(--shadow-3);
      isolation: isolate;
    }

    .page-hero__art::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: inherit;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
      pointer-events: none;
    }

    .band-light .page-hero__art::before {
      box-shadow: inset 0 0 0 1px rgba(0, 35, 82, 0.1);
    }

    .page-hero__art :global(picture) {
      position: absolute;
      inset: 0;
    }

    .page-hero__art :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--pos);
      transform: scale(var(--scale));
      transform-origin: var(--pos);
    }
  }
</style>
