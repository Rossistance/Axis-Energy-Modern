---
/**
 * Inner-page header, shared by every page except home so they all keep the same compact
 * height (the Services header from the 2026-09-30 review): breadcrumbs, eyebrow, title and
 * one short lead over a full-width photo. Longer copy, buttons and facts belong in the page
 * body, not here.
 *
 * The photo comes from src/data/heroes.ts. While it is a placeholder, preview builds label
 * it "Placeholder photo"; small source photos are softened rather than shown enlarged.
 */
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Breadcrumbs from './Breadcrumbs.astro';
import type { HeroPhoto } from '@data/heroes';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  photo?: HeroPhoto;
  crumbs?: { label: string; href: string }[];
  /** Align the text with a narrow article column. */
  narrow?: boolean;
}

const { eyebrow, title, lead, photo, crumbs, narrow = false } = Astro.props;
const preview = (import.meta.env.PUBLIC_SITE_MODE ?? 'preview') !== 'production';
const hasMedia = Astro.slots.has('media');
/** Photos narrower than this are blurred slightly, since they are stretched to full width. */
const SHARP_WIDTH = 1100;
const showTag = !!photo?.placeholder && preview;
const widths = photo
  ? [480, 800, 1200, 1600, 2400].filter((w) => w < photo.src.width).concat(photo.src.width)
  : [];
---

<section
  class:list={[
    'page-hero',
    'band-dark',
    {
      'page-hero--soft': photo && photo.src.width < SHARP_WIDTH,
      'page-hero--narrow': narrow,
      'page-hero--tagged': showTag,
    },
  ]}
  aria-labelledby="page-title"
>
  {photo && (
    <div class="page-hero__photo" aria-hidden="true" style={`--pos: ${photo.position ?? 'center'}`}>
      <Picture
        src={photo.src}
        alt=""
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={widths}
        sizes="100vw"
        loading="eager"
        decoding="async"
      />
    </div>
  )}
  <div class:list={['container', { 'container--narrow': narrow }, 'page-hero__inner']}>
    {crumbs && <Breadcrumbs items={crumbs} />}
    <div class:list={['page-hero__body', { 'page-hero__body--media': hasMedia }]}>
      {hasMedia && <slot name="media" />}
      <div class="page-hero__copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 id="page-title">{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
    </div>
    {showTag && (
      <p class="page-hero__tag">
        <Icon name="lucide:image" />
        Placeholder photo
      </p>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .page-hero__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .page-hero__photo :global(picture),
  .page-hero__photo :global(img) {
    width: 100%;
    height: 100%;
  }

  .page-hero__photo :global(img) {
    object-fit: cover;
    object-position: var(--pos);
  }

  .page-hero--soft .page-hero__photo :global(img) {
    filter: blur(3px);
    transform: scale(1.06);
  }

  /* Navy scrim: solid enough behind the text for AA contrast, lighter on the right on wide
     screens so the photo reads. */
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgba(12, 62, 82, 0.35), transparent 60%),
      linear-gradient(180deg, rgba(0, 35, 82, 0.8), rgba(0, 35, 82, 0.88));
  }

  .page-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--page-hero-min);
    padding-block: var(--page-hero-pad-top) var(--page-hero-pad-bottom);
  }

  .page-hero__body--media {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .page-hero__copy .eyebrow {
    margin-bottom: 0.55rem;
  }

  .page-hero__copy h1 {
    font-size: var(--h1-page);
    max-width: 30ch;
    margin: 0;
    color: #fff;
    text-wrap: balance;
  }

  .page-hero__copy .lead {
    max-width: 68ch;
    margin: 0.6rem 0 0;
    font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.15rem);
  }

  .page-hero__tag {
    position: absolute;
    right: 0;
    bottom: 0.55rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--r-pill);
    background: rgba(0, 20, 45, 0.55);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .page-hero__tag :global(svg) {
    width: 13px;
    height: 13px;
  }

  /* Phones: room under the text for the placeholder label. */
  @media (max-width: 899px) {
    .page-hero--tagged .page-hero__inner {
      padding-bottom: calc(var(--page-hero-pad-bottom) + 1rem);
    }
  }

  @media (min-width: 900px) {
    .page-hero::before {
      background:
        linear-gradient(0deg, rgba(12, 62, 82, 0.3), transparent 55%),
        linear-gradient(
          90deg,
          rgba(0, 35, 82, 0.94) 0%,
          rgba(0, 35, 82, 0.86) 42%,
          rgba(0, 35, 82, 0.5) 74%,
          rgba(0, 35, 82, 0.3) 100%
        );
    }

    .page-hero__copy {
      max-width: 62%;
    }

    .page-hero--narrow::before {
      background:
        linear-gradient(0deg, rgba(12, 62, 82, 0.3), transparent 55%),
        linear-gradient(180deg, rgba(0, 35, 82, 0.86), rgba(0, 35, 82, 0.9));
    }

    .page-hero--narrow .page-hero__copy {
      max-width: none;
    }
  }
</style>
