---
/**
 * Published projects grouped under type headings. Used on the Projects page and, for the
 * remaining projects, on its service views.
 *
 * Each group starts its own full-width row (owner, 2026-10-28: types never share a line);
 * its cards sit up to four to a row, on the same columns in every group so they line up.
 * Groups show no project count or size totals (owner, 2026-10-28): the page grows as profiles
 * are added, and running totals belong to By the numbers on Why Axis.
 */
import ProjectCard from '@components/ProjectCard.astro';
import { groupByType, type Project } from '@lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const groups = groupByType(projects);
---

<div class="type-groups">
  {groups.map((group) => (
    <div class="type-group" id={`type-${group.type}`}>
      <div class="type-group__head">
        <h3>{group.label}</h3>
      </div>
      <div class="type-group__grid" data-reveal-group>
        {group.projects.map((p) => (
          <ProjectCard project={p} level={4} showType={false} />
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .type-groups {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .type-group {
    display: grid;
    row-gap: 1rem;
  }

  .type-group__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .type-group__head {
    display: grid;
    gap: 0.1rem;
    padding-bottom: 0.55rem;
    border-bottom: 2px solid var(--line);
  }

  .type-group__head h3 {
    margin: 0;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
  }

  @media (min-width: 560px) {
    .type-group__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 860px) {
    .type-group__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .type-group__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
