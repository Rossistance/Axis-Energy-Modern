---
/**
 * Published projects grouped under type headings, each with its project count and size.
 * Used on the Projects page and, for the remaining projects, on its service views.
 *
 * Groups sit side by side on one four-column grid, each spanning as many columns as it has
 * cards, so small groups share a row instead of leaving most of it empty. The groups are
 * ordered to fill the rows (each goes into the first row of four with room for it), and
 * that order is the reading order at every width.
 */
import ProjectCard from '@components/ProjectCard.astro';
import { formatSize, formatStorage } from '@lib/format';
import { groupByType, portfolioTotals, type Project } from '@lib/projects';

interface Props {
  projects: Project[];
}

const COLUMNS = 4;
const { projects } = Astro.props;
const groups = groupByType(projects).map((g) => ({
  ...g,
  span: Math.min(g.projects.length, COLUMNS),
  totals: portfolioTotals(g.projects),
}));

const rows: { used: number; items: typeof groups }[] = [];
for (const group of groups) {
  const row = rows.find((r) => r.used + group.span <= COLUMNS);
  if (row) {
    row.items.push(group);
    row.used += group.span;
  } else {
    rows.push({ used: group.span, items: [group] });
  }
}
const packed = rows.flatMap((r) => r.items);
---

<div class="type-groups">
  {packed.map((group) => (
    <div class="type-group" id={`type-${group.type}`} data-span={group.span}>
      <div class="type-group__head">
        <h3>{group.label}</h3>
        <p class="type-group__meta tabular">
          {group.totals.count} {group.totals.count === 1 ? 'project' : 'projects'} ·{' '}
          {formatSize(group.totals.mwdc)}
          {group.totals.mwh > 0 && ` · ${formatStorage(group.totals.mwh)}`}
        </p>
      </div>
      <div class="type-group__grid" data-reveal-group>
        {group.projects.map((p) => (
          <ProjectCard project={p} level={4} showType={false} />
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .type-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2rem) 1rem;
  }

  /* A group's cards sit on the page grid's own columns; groups sharing a row stretch to
     the same height, so their cards line up. */
  .type-group,
  .type-group__grid {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 1rem;
  }

  .type-group {
    grid-template-rows: auto 1fr;
  }

  .type-group__head,
  .type-group__grid {
    grid-column: 1 / -1;
  }

  .type-group__head {
    display: grid;
    gap: 0.1rem;
    padding-bottom: 0.55rem;
    border-bottom: 2px solid var(--line);
  }

  .type-group__head h3 {
    margin: 0;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
  }

  .type-group__meta {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
  }

  @media (min-width: 560px) {
    .type-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .type-group:not([data-span='1']) {
      grid-column: span 2;
    }
  }

  @media (min-width: 860px) {
    .type-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .type-group[data-span='3'],
    .type-group[data-span='4'] {
      grid-column: span 3;
    }
  }

  @media (min-width: 1100px) {
    .type-groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .type-group[data-span='4'] {
      grid-column: span 4;
    }
  }
</style>
