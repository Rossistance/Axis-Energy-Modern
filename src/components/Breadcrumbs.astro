---
import { Icon } from 'astro-icon/components';
import { href, absoluteUrl } from '@lib/href';
import { breadcrumbSchema } from '@lib/schema';

interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
const all = [{ label: 'Home', href: '/' }, ...items];
const schema = breadcrumbSchema(
  all.map((i) => ({ name: i.label, url: absoluteUrl(i.href, Astro.site) })),
);
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {all.map((item, i) => (
      <li>
        {i < all.length - 1 ? (
          <a href={href(item.href)}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
        {i < all.length - 1 && <Icon name="lucide:chevron-right" />}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<style>
  .crumbs {
    margin-bottom: clamp(0.6rem, 1.4vw, 0.9rem);
    font-size: var(--text-sm);
  }

  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
  }

  .crumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  .crumbs span[aria-current] {
    color: var(--text);
    font-weight: 500;
  }

  .crumbs :global(svg) {
    width: 14px;
    height: 14px;
    opacity: 0.7;
  }
</style>
