---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { href } from '@lib/href';
import { formatSize, formatStorage } from '@lib/format';
import { TYPE_LABELS, projectLocation, type Project } from '@lib/projects';

interface Props {
  project: Project;
  featured?: boolean;
  /** Heading level for the title: 4 when the card sits under a group heading. */
  level?: 3 | 4;
  /** Hide the type label when a group heading already names the type. */
  showType?: boolean;
}

const { project, featured = false, level = 3, showType = true } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
const { data } = project;
const url = href(`/project/${project.id}/`);
const storage = formatStorage(data.storageMwh);
---

<article
  class:list={['project-card', 'card', 'card--lift', { 'project-card--featured': featured }]}
>
  <a href={url} class="project-card__media" aria-hidden="true" tabindex="-1">
    {data.image ? (
      <Image
        src={data.image}
        alt=""
        widths={[400, 640, 900]}
        sizes="(min-width: 900px) 33vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="project-card__nophoto">
        <Icon name="lucide:image" />
        Project photo to come
      </span>
    )}
    {showType && <span class="chip project-card__type">{TYPE_LABELS[data.type]}</span>}
  </a>
  <div class="project-card__body">
    <Heading class="project-card__title">
      <a href={url}>{data.title}</a>
    </Heading>
    <p class="project-card__loc">
      <Icon name="lucide:map-pin" />
      {projectLocation(project)}
    </p>
    <p class="project-card__summary">{data.summary}</p>
    <dl class="project-card__meta">
      <div>
        <dt>Size</dt>
        <dd class="tabular">{formatSize(data.sizeMwdc)}</dd>
      </div>
      {storage && (
        <div>
          <dt>Storage</dt>
          <dd class="tabular">{storage}</dd>
        </div>
      )}
      {data.year && (
        <div>
          <dt>Completed</dt>
          <dd class="tabular">{data.year}</dd>
        </div>
      )}
      <div>
        <dt>Role</dt>
        <dd>{data.role.join(', ')}</dd>
      </div>
    </dl>
  </div>
</article>

<style>
  .project-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--navy-deep);
    overflow: hidden;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.04);
  }

  /* No photo yet: a plain panel that says so, rather than another project's picture. */
  .project-card__nophoto {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    height: 100%;
    background: var(--grad-band);
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .project-card__nophoto :global(svg) {
    width: 28px;
    height: 28px;
    opacity: 0.7;
  }

  .project-card__type {
    position: absolute;
    left: 0.9rem;
    top: 0.9rem;
    background: rgba(255, 255, 255, 0.92);
    color: var(--brand-navy);
  }

  /* Title, location and summary keep their natural height; the spare height of an
     equal-height card goes to the meta row, pinned to the bottom. Stretching every row
     made the 3-line summary box taller than 3 lines, so a sliver of line 4 showed. */
  .project-card__body {
    padding: 1.25rem 1.35rem 1.4rem;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 0.6rem;
    flex: 1;
  }

  .project-card__title {
    font-size: 1.2rem;
    margin: 0;
  }

  .project-card__title a {
    color: var(--text);
    text-decoration: none;
  }

  .project-card__title a:hover {
    color: var(--brand-blue);
  }

  .project-card__loc {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  .project-card__loc :global(svg) {
    width: 14px;
    height: 14px;
  }

  .project-card__summary {
    font-size: 0.95rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .project-card__meta {
    align-self: end;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 0.5rem 1rem;
    margin: 0.5rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  .project-card__meta dt {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .project-card__meta dd {
    margin: 0;
    font-weight: 600;
  }
</style>
