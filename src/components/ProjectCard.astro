---
/**
 * Compact project card: a 16:9 photo, the title, the location and one line of key figures
 * (size, storage, year). The summary, role and scope live on the project page, so the
 * card stays small enough for four in a row.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { href } from '@lib/href';
import { formatSize, formatStorage } from '@lib/format';
import { TYPE_LABELS, projectLocation, type Project } from '@lib/projects';

interface Props {
  project: Project;
  /** Heading level for the title: 4 when the card sits under a group heading. */
  level?: 3 | 4;
  /** Hide the type label when a group heading already names the type. */
  showType?: boolean;
}

const { project, level = 3, showType = true } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
const { data } = project;
const url = href(`/project/${project.id}/`);
const storage = formatStorage(data.storageMwh);
const facts = [
  formatSize(data.sizeMwdc),
  storage && `${storage} storage`,
  data.year && String(data.year),
].filter(Boolean);
---

<article class="project-card card card--lift">
  <a href={url} class="project-card__media" aria-hidden="true" tabindex="-1">
    {data.image ? (
      <Image
        src={data.image}
        alt=""
        widths={[320, 480, 640]}
        sizes="(min-width: 1100px) 290px, (min-width: 640px) 45vw, 100vw"
        loading="lazy"
        decoding="async"
        style={data.imageFocus ? `object-position: ${data.imageFocus}` : undefined}
      />
    ) : (
      <span class="project-card__nophoto">
        <Icon name="lucide:image" />
        Project photo to come
      </span>
    )}
    {showType && <span class="chip project-card__type">{TYPE_LABELS[data.type]}</span>}
  </a>
  <div class="project-card__body">
    <Heading class="project-card__title">
      <a href={url}>{data.title}</a>
    </Heading>
    <p class="project-card__loc">
      <Icon name="lucide:map-pin" />
      {projectLocation(project)}
    </p>
    <p class="project-card__facts tabular">{facts.join(' · ')}</p>
  </div>
</article>

<style>
  .project-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--navy-deep);
    overflow: hidden;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.04);
  }

  /* No photo yet: a plain panel that says so, rather than another project's picture. */
  .project-card__nophoto {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.35rem;
    height: 100%;
    background: var(--grad-band);
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .project-card__nophoto :global(svg) {
    width: 22px;
    height: 22px;
    opacity: 0.7;
  }

  .project-card__type {
    position: absolute;
    left: 0.6rem;
    top: 0.6rem;
    background: rgba(255, 255, 255, 0.92);
    color: var(--brand-navy);
  }

  .project-card__body {
    display: grid;
    gap: 0.3rem;
    padding: 0.8rem 0.95rem 0.9rem;
  }

  .project-card__title {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .project-card__title a {
    color: var(--text);
    text-decoration: none;
  }

  .project-card__title a:hover {
    color: var(--brand-blue);
  }

  .project-card__loc {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .project-card__loc :global(svg) {
    width: 13px;
    height: 13px;
    flex: none;
  }

  .project-card__facts {
    margin: 0.15rem 0 0;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--brand-blue);
  }

  /* Phones: one card per row, so a thumbnail beside the text instead of a full-width
     photo keeps a list of projects short. */
  @media (max-width: 559px) {
    .project-card {
      flex-direction: row;
      align-items: stretch;
    }

    .project-card__media {
      flex: none;
      width: 7.5rem;
      aspect-ratio: auto;
      min-height: 5.25rem;
    }

    .project-card__type {
      display: none;
    }

    .project-card__body {
      align-content: center;
      padding: 0.6rem 0.8rem;
    }
  }
</style>
