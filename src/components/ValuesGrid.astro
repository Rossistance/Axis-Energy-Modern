---
import { values, mission, vision } from '@data/pillars';
---

<div class="values">
  <div class="values__intro" data-reveal>
    <p class="eyebrow">Mission and vision</p>
    <h2>{vision}</h2>
    <p class="lead">
      Our mission is simple to say and hard to do: <strong>{mission.replace(' | ', ' — ')}</strong>.
      Four values shape how we show up for customers, vendors and each other.
    </p>
  </div>
  <ol class="values__list" data-reveal-group>
    {values.map((v) => (
      <li class="value">
        <h3>{v.title}</h3>
        <p>{v.body}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .values {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .values__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
    counter-reset: value;
  }

  .value {
    background: var(--surface);
    padding: clamp(1.4rem, 3vw, 2rem);
    position: relative;
    counter-increment: value;
  }

  .value::before {
    content: counter(value, decimal-leading-zero);
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--brand-green);
    margin-bottom: 0.75rem;
  }

  .value h3 {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand-blue);
    margin-bottom: 0.5rem;
  }

  .value p {
    color: var(--text-muted);
    font-size: 0.98rem;
  }

  @media (min-width: 720px) {
    .values__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .values {
      grid-template-columns: 5fr 7fr;
      align-items: center;
    }

    .values__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
