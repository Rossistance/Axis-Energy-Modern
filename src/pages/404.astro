---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import heroArt from '@assets/hero/hero-why-axis.png';
import { href } from '@lib/href';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Contact', href: '/contact/' },
];
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noindex
  cta="compact"
>
  <section class="section nf">
    <div class="container split">
      <div>
        <p class="eyebrow">404</p>
        <h1>We couldn’t find that page.</h1>
        <p class="lead">
          The link may be out of date, or the page may have moved during our site redesign. Try one
          of these instead.
        </p>
        <ul class="nf__links">
          {links.map((l) => (
            <li>
              <a class="btn btn--secondary" href={href(l.href)}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="nf__art">
        <Image
          src={heroArt}
          alt=""
          format="webp"
          widths={[480, 800]}
          sizes="(min-width: 900px) 40vw, 100vw"
          loading="eager"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .nf__art {
    border-radius: var(--r-xl);
    overflow: hidden;
    filter: saturate(0.4);
    max-width: 480px;
    margin-inline: auto;
  }
</style>
