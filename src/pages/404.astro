---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import { heroes } from '@data/heroes';
import { href } from '@lib/href';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Contact', href: '/contact/' },
];
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noindex
  cta="compact"
>
  <PageHero
    eyebrow="404"
    title="We couldn’t find that page."
    lead="The link may be out of date, or the page may have moved during our site redesign. Try one of these instead."
    photo={heroes.notFound}
  />

  <section class="section section--sm" aria-label="Suggested pages">
    <div class="container">
      <ul class="nf__links">
        {links.map((l) => (
          <li>
            <a class="btn btn--secondary" href={href(l.href)}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
