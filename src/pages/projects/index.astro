---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ProjectCard from '@components/ProjectCard.astro';
import heroArt from '@assets/hero/hero-projects.png';
import { href } from '@lib/href';
import { formatSize, formatStorage, stateName } from '@lib/format';
import { getPublishedProjects, portfolioTotals, TYPE_LABELS, projectLocation } from '@lib/projects';

const projects = await getPublishedProjects();
const totals = portfolioTotals(projects);
const types = [...new Set(projects.map((p) => p.data.type))];
const states = [...new Set(projects.map((p) => p.data.state))].sort();
const roles = [...new Set(projects.flatMap((p) => p.data.role))];
const description =
  'Selected Axis Energy projects: utility-scale portfolios, rooftop and carport solar, and solar + storage across the Southeast and beyond.';
---

<BaseLayout title="Projects" {description}>
  <PageHero
    eyebrow="Projects"
    title="Excellence in Execution"
    lead="Axis Energy brings you a direct, one-to-one partnership that provides a total EPC and O&M solution. Explore a selection of the work our team has delivered for utilities, manufacturers, developers and municipalities."
    art={heroArt}
    crumbs={[{ label: 'Projects', href: '/projects/' }]}
  >
    <ul class="totals" aria-label="Published portfolio totals">
      <li>
        <strong class="tabular">{formatSize(totals.mwdc)}</strong>
        <span>published capacity</span>
      </li>
      <li>
        <strong class="tabular">{totals.sites}</strong>
        <span>sites</span>
      </li>
      <li>
        <strong class="tabular">{totals.states.length}</strong>
        <span>{totals.states.length === 1 ? 'state' : 'states'}</span>
      </li>
      {totals.mwh > 0 && (
        <li>
          <strong class="tabular">{formatStorage(totals.mwh)}</strong>
          <span>storage</span>
        </li>
      )}
    </ul>
  </PageHero>

  <section class="section" aria-labelledby="portfolio-title">
    <div class="container">
      <SectionHeading
        eyebrow="Portfolio"
        title="Selected projects"
        lead="Filter by project type, state or role. Published case studies appear here; additional completed projects are added as clients approve them."
        id="portfolio-title"
      />

      <form class="filters" data-filters aria-label="Filter projects">
        <div class="filters__group">
          <label for="f-type">Type</label>
          <select id="f-type" name="type" class="select">
            <option value="">All types</option>
            {types.map((t) => (
              <option value={t}>{TYPE_LABELS[t]}</option>
            ))}
          </select>
        </div>
        <div class="filters__group">
          <label for="f-state">State</label>
          <select id="f-state" name="state" class="select">
            <option value="">All states</option>
            {states.map((s) => (
              <option value={s}>{stateName(s)}</option>
            ))}
          </select>
        </div>
        <div class="filters__group">
          <label for="f-role">Role</label>
          <select id="f-role" name="role" class="select">
            <option value="">All roles</option>
            {roles.map((r) => (
              <option value={r}>{r}</option>
            ))}
          </select>
        </div>
        <div class="filters__group">
          <label for="f-sort">Sort</label>
          <select id="f-sort" name="sort" class="select">
            <option value="featured">Featured</option>
            <option value="size">Largest first</option>
            <option value="year">Newest first</option>
          </select>
        </div>
        <div class="filters__actions">
          <button type="submit" class="btn btn--secondary btn--sm">
            Apply
          </button>
          <button type="button" class="btn btn--ghost btn--sm" data-filters-reset>
            Reset
          </button>
        </div>
        <p class="filters__count" data-filters-count aria-live="polite">
          {projects.length} projects
        </p>
      </form>

      <div class="grid grid--3" data-project-grid data-reveal-group>
        {projects.map((p) => (
          <ProjectCard project={p} />
        ))}
      </div>
      <p class="filters__empty card" data-filters-empty hidden>
        No projects match those filters.{' '}
        <button type="button" class="btn btn--ghost btn--sm" data-filters-reset>
          Show all
        </button>
      </p>
    </div>
  </section>

  <section class="section band-alt" aria-labelledby="table-title">
    <div class="container">
      <SectionHeading eyebrow="At a glance" title="Project list" id="table-title" align="row">
        <a class="btn btn--secondary" href={href('/request-a-quote/?topic=case-studies')}>
          Request case studies <Icon name="lucide:arrow-right" class="icon" />
        </a>
      </SectionHeading>
      <div class="table-wrap" data-reveal>
        <table class="table" data-sortable>
          <caption class="sr-only">
            Published Axis Energy projects with size, location, completion year and role
          </caption>
          <thead>
            <tr>
              <th scope="col">
                <button type="button" data-sort="text">
                  Project
                </button>
              </th>
              <th scope="col">
                <button type="button" data-sort="text">
                  Type
                </button>
              </th>
              <th scope="col">
                <button type="button" data-sort="text">
                  Location
                </button>
              </th>
              <th scope="col" class="num">
                <button type="button" data-sort="num">
                  Size (MWdc)
                </button>
              </th>
              <th scope="col" class="num">
                <button type="button" data-sort="num">
                  Storage (MWh)
                </button>
              </th>
              <th scope="col" class="num">
                <button type="button" data-sort="num">
                  Completed
                </button>
              </th>
              <th scope="col">
                <button type="button" data-sort="text">
                  Role
                </button>
              </th>
            </tr>
          </thead>
          <tbody>
            {projects.map((p) => (
              <tr>
                <td>
                  <a href={href(`/project/${p.id}/`)}>{p.data.title}</a>
                </td>
                <td>{TYPE_LABELS[p.data.type]}</td>
                <td>{projectLocation(p)}</td>
                <td class="num" data-value={p.data.sizeMwdc}>
                  {p.data.sizeMwdc.toLocaleString('en-US', { maximumFractionDigits: 2 })}
                </td>
                <td class="num" data-value={p.data.storageMwh ?? 0}>
                  {p.data.storageMwh
                    ? p.data.storageMwh.toLocaleString('en-US', { maximumFractionDigits: 2 })
                    : '—'}
                </td>
                <td class="num" data-value={p.data.year ?? 0}>
                  {p.data.year ?? '—'}
                </td>
                <td>{p.data.role.join(', ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .totals {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.25rem;
  }

  .totals li {
    display: grid;
  }

  .totals strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.1;
  }

  .totals span {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1.75rem;
    padding: 1rem 1.1rem;
    border-radius: var(--r-lg);
    background: var(--mist-50);
    border: 1px solid var(--line);
  }

  html:not(.js) .filters {
    display: none;
  }

  .filters__group {
    display: grid;
    gap: 0.3rem;
    min-width: 160px;
    flex: 1;
  }

  .filters__group label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .filters .select {
    min-height: 42px;
    padding-block: 0.45rem;
  }

  .filters__actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .filters__count {
    margin: 0 0 0.6rem auto;
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-weight: 500;
  }

  .filters__empty {
    margin-top: 1rem;
    text-align: center;
  }

  [data-sortable] th button {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  [data-sortable] th[aria-sort] button::after {
    content: ' ↕';
    opacity: 0.5;
  }

  [data-sortable] th[aria-sort='ascending'] button::after {
    content: ' ↑';
    opacity: 1;
  }

  [data-sortable] th[aria-sort='descending'] button::after {
    content: ' ↓';
    opacity: 1;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  if (form && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.project-card'));
    const count = document.querySelector<HTMLElement>('[data-filters-count]');
    const empty = document.querySelector<HTMLElement>('[data-filters-empty]');
    const selects = Array.from(form.querySelectorAll<HTMLSelectElement>('select'));
    const original = cards.map((c, i) => ({ c, i }));

    const val = (name: string) =>
      (form.elements.namedItem(name) as HTMLSelectElement | null)?.value ?? '';
    const apply = () => {
      const type = val('type');
      const state = val('state');
      const role = val('role');
      const sort = val('sort');
      let visible = 0;
      const ordered = [...original].sort((a, b) => {
        if (sort === 'size') return Number(b.c.dataset.size) - Number(a.c.dataset.size);
        if (sort === 'year') return Number(b.c.dataset.year) - Number(a.c.dataset.year);
        return a.i - b.i;
      });
      ordered.forEach(({ c }) => grid.appendChild(c));
      cards.forEach((c) => {
        const show =
          (!type || c.dataset.type === type) &&
          (!state || c.dataset.state === state) &&
          (!role || (c.dataset.role ?? '').split('|').includes(role));
        c.hidden = !show;
        if (show) visible++;
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;
      if (empty) empty.hidden = visible > 0;
      const params = new URLSearchParams();
      selects.forEach((s) => {
        if (s.value && !(s.name === 'sort' && s.value === 'featured')) params.set(s.name, s.value);
      });
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      apply();
    });
    const initial = new URLSearchParams(location.search);
    selects.forEach((s) => {
      const v = initial.get(s.name);
      if (v && Array.from(s.options).some((o) => o.value === v)) s.value = v;
      s.addEventListener('change', apply);
    });
    document.querySelectorAll('[data-filters-reset]').forEach((b) =>
      b.addEventListener('click', () => {
        form.reset();
        apply();
      }),
    );
    apply();
  }

  const table = document.querySelector<HTMLTableElement>('[data-sortable]');
  if (table) {
    const tbody = table.tBodies[0];
    table.querySelectorAll<HTMLTableCellElement>('th').forEach((th, index) => {
      const btn = th.querySelector('button');
      if (!btn) return;
      th.setAttribute('aria-sort', 'none');
      btn.addEventListener('click', () => {
        const type = btn.dataset.sort;
        const dir = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
        table.querySelectorAll('th').forEach((t) => t.setAttribute('aria-sort', 'none'));
        th.setAttribute('aria-sort', dir);
        const rows = Array.from(tbody.rows);
        rows.sort((a, b) => {
          const ca = a.cells[index];
          const cb = b.cells[index];
          let r: number;
          if (type === 'num') r = Number(ca.dataset.value ?? 0) - Number(cb.dataset.value ?? 0);
          else r = (ca.textContent ?? '').localeCompare(cb.textContent ?? '');
          return dir === 'ascending' ? r : -r;
        });
        rows.forEach((row) => tbody.appendChild(row));
      });
    });
  }
</script>
