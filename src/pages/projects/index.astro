---
/**
 * Projects: published projects grouped by type. Each service page's "See projects" link
 * opens a view of this page focused on that service (projects/[service].astro). The
 * markets moved to their own page (/markets/) on 2026-10-01; old links to a market section
 * of this page are forwarded there.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ProjectTypeGroups from '@components/ProjectTypeGroups.astro';
import { heroes } from '@data/heroes';
import { MARKET_IDS } from '@data/project-markets';
import { routes } from '@data/routes';
import { href } from '@lib/href';
import { getPublishedProjects } from '@lib/projects';

const projects = await getPublishedProjects();
const description =
  'Axis Energy projects by type: solar, solar + storage, microgrids and rooftop work for commercial and industrial owners, cooperatives and utilities, municipalities and developers.';
const forward = { ids: ['markets', ...MARKET_IDS], markets: href(routes.markets) };
---

<BaseLayout title="Projects" {description}>
  <PageHero
    eyebrow="Projects"
    title="Excellence in Execution"
    lead="Axis Energy brings you a direct, one-to-one partnership that provides a total EPC and O&M solution."
    photo={heroes.projects}
    crumbs={[{ label: 'Projects', href: routes.projects }]}
  />

  <section class="section section--sm" aria-labelledby="types-title">
    <div class="container">
      <h2 id="types-title" class="sr-only">
        Projects by type
      </h2>
      <ProjectTypeGroups {projects} />
    </div>
  </section>

  <script is:inline define:vars={{ forward }}>
    // /projects/#co-ops-utilities and the like: the markets now live on /markets/.
    const id = decodeURIComponent(location.hash.slice(1));
    if (forward.ids.includes(id)) {
      location.replace(forward.markets + (id === 'markets' ? '' : `#${id}`));
    }
  </script>
</BaseLayout>
