---
/**
 * Services: one card per service page. Opened from "Services" in the main menu.
 */
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import { heroes } from '@data/heroes';
import { servicePages, servicePath } from '@data/services';
import { href } from '@lib/href';

const description =
  'A total EPC and O&M solution: solar EPC, battery storage and microgrids, electrical infrastructure and commissioning, and O&M and technical services.';
---

<BaseLayout title="Services" {description}>
  <PageHero
    eyebrow="Services"
    title="A Total EPC and O&M Solution"
    lead="Our clients enjoy great peace of mind being able to make one phone call to Axis Energy and know their renewable energy project will be executed with excellence."
    photo={heroes.services}
    crumbs={[{ label: 'Services', href: '/services/' }]}
  />

  <section class="section" aria-labelledby="services-list-title">
    <div class="container">
      <h2 id="services-list-title" class="sr-only">
        Our services
      </h2>
      <ul class="service-cards" data-reveal-group>
        {servicePages.map((page) => (
          <li>
            <a class="card card--lift service-card" href={href(servicePath(page.slug))}>
              <div class="icon-tile">
                <Icon name={page.icon} />
              </div>
              <h3>{page.title}</h3>
              <p>{page.summary}</p>
              <span class="link-arrow service-card__more">
                Learn more <Icon name="lucide:arrow-right" class="icon" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .service-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 760px) {
    .service-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .service-cards li {
    display: flex;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
    color: var(--text);
    text-decoration: none;
  }

  .service-card h3 {
    font-size: 1.35rem;
    margin: 0.35rem 0 0;
  }

  .service-card:hover h3 {
    color: var(--brand-blue);
  }

  .service-card p {
    color: var(--text-muted);
  }

  .service-card__more {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--link);
  }
</style>
