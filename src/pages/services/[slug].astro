---
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ServiceBlock from '@components/ServiceBlock.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ProcessTimeline from '@components/ProcessTimeline.astro';
import { heroes } from '@data/heroes';
import photoFloydRoad from '@assets/projects/floyd-road-gaston-nc.png';
import photoWalnutGrove from '@assets/projects/walnut-grove-microgrid.jpg';
import photoEquipmentYard from '@assets/projects/walnut-grove-microgrid-equipment-yard.jpg';
import photoCooperative from '@assets/projects/cooperative-solar-storage-portfolio.jpg';
import {
  servicePages,
  omOfferings,
  process,
  experienceGroups,
  servicePath,
  offeringPath,
  serviceProjectsPath,
  OM_PAGE_SLUG,
  type ServicePage,
} from '@data/services';
import { href } from '@lib/href';

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: ServicePage };

const photos: Record<string, { src: ImageMetadata; alt: string; caption: string }> = {
  'solar-epc': {
    src: photoFloydRoad,
    alt: 'Aerial view of the Floyd Road utility-scale solar farm near Gaston, North Carolina',
    caption: 'Floyd Road · 6.75 MW · Gaston, NC',
  },
  'battery-storage-and-microgrids': {
    src: photoWalnutGrove,
    alt: 'Aerial view of a microgrid battery storage and medium-voltage equipment yard beside rows of tracking solar panels',
    caption: 'Walnut Grove Microgrid · 2.751 MWdc + 5.014 MWh · Walnut Grove, MS',
  },
  'electrical-infrastructure-and-commissioning': {
    src: photoEquipmentYard,
    alt: "Overhead view of the microgrid's battery containers, inverters and medium-voltage equipment on a gravel pad",
    caption: 'Walnut Grove Microgrid equipment yard · Walnut Grove, MS',
  },
  'om-and-technical-services': {
    src: photoCooperative,
    alt: 'Aerial view of a ground-mounted solar array and its battery storage and inverter pad in rural North Carolina',
    caption: 'Cooperative Solar and Storage Portfolio · maintained by Axis since operations began',
  },
};

const others = servicePages.filter((p) => p.slug !== page.slug);
const isOm = page.slug === OM_PAGE_SLUG;
---

<BaseLayout title={page.title} description={page.summary}>
  <PageHero
    eyebrow="Services"
    title={page.title}
    lead={page.summary}
    photo={heroes[page.slug as keyof typeof heroes] ?? heroes.services}
    crumbs={[
      { label: 'Services', href: '/services/' },
      { label: page.title, href: servicePath(page.slug) },
    ]}
  />

  <ServiceBlock group={page.block} photo={photos[page.slug]} detail={page.lead}>
    <a slot="footer" class="see-projects" href={href(serviceProjectsPath(page.slug))}>
      <Icon name="lucide:layout-grid" class="see-projects__icon" />
      <span>
        See projects<span class="sr-only"> for {page.title}</span>
      </span>
      <Icon name="lucide:arrow-right" class="see-projects__arrow" />
    </a>
  </ServiceBlock>

  {isOm && (
    <section class="section band-alt" aria-labelledby="offerings-title">
      <div class="container">
        <SectionHeading
          eyebrow="Technical services"
          title="O&M and technical services offerings"
          id="offerings-title"
        />
        <div class="grid grid--3" data-reveal-group>
          {omOfferings.map((o) => (
            <a class="card card--lift offering-card" href={href(offeringPath(o.slug))}>
              <h3>{o.title}</h3>
              <p>{o.summary}</p>
              <span class="link-arrow">
                Learn more <Icon name="lucide:arrow-right" class="icon" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {page.slug === 'solar-epc' && (
    <section class="section" aria-labelledby="experience-title">
      <div class="container">
        <SectionHeading
          eyebrow="Our experience"
          title="Community, commercial and specialty solar"
          id="experience-title"
        />
        <div class="grid grid--3" data-reveal-group>
          {experienceGroups.map((g) => (
            <div class="experience__item">
              <h3>{g.title}</h3>
              <p class="experience__detail">{g.detail}</p>
              <p class="experience__example">Example: {g.example}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {page.slug === 'solar-epc' && (
    <section class="section band-alt" aria-labelledby="process-title">
      <div class="container">
        <SectionHeading
          eyebrow="How we work"
          title="One point of contact from first call to final commissioning"
          lead="Every project runs through the same disciplined sequence, led by an Axis project manager and an experienced superintendent on site."
          id="process-title"
        />
        <ProcessTimeline steps={process} />
      </div>
    </section>
  )}

  <section class="section band-alt" aria-labelledby="more-title">
    <div class="container">
      <SectionHeading eyebrow="Services" title="More from Axis" id="more-title" />
      <div class="grid grid--3" data-reveal-group>
        {others.map((o) => (
          <a class="card card--lift offering-card" href={href(servicePath(o.slug))}>
            <div class="icon-tile">
              <Icon name={o.icon} />
            </div>
            <h3>{o.title}</h3>
            <p>{o.summary}</p>
            <span class="link-arrow">
              Learn more <Icon name="lucide:arrow-right" class="icon" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* "See projects": a pill under What we deliver, styled like the home page highlights. */
  .see-projects {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: #fff;
    color: var(--brand-navy);
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-1);
    transition:
      transform var(--dur-1, 150ms) ease,
      box-shadow var(--dur-1, 150ms) ease,
      border-color var(--dur-1, 150ms) ease;
  }

  .see-projects:hover {
    border-color: var(--brand-blue);
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }

  .see-projects :global(.see-projects__icon) {
    width: 18px;
    height: 18px;
    color: var(--brand-green);
  }

  .see-projects :global(.see-projects__arrow) {
    width: 16px;
    height: 16px;
    color: var(--link);
    transition: transform var(--dur-1, 150ms) ease;
  }

  .see-projects:hover :global(.see-projects__arrow) {
    transform: translateX(2px);
  }

  .experience__item {
    padding: 1.35rem;
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, rgba(0, 75, 141, 0.06), rgba(0, 135, 82, 0.08));
  }

  .experience__item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .experience__detail {
    font-weight: 600;
    color: var(--brand-blue);
    font-size: var(--text-sm);
  }

  .experience__example {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-top: 0.4rem;
  }

  .offering-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
  }

  .offering-card h3 {
    font-size: 1.15rem;
    margin: 0;
  }

  .offering-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .offering-card .link-arrow {
    margin-top: auto;
    padding-top: 0.25rem;
    color: var(--link);
  }
</style>
