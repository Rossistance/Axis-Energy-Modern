---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import heroArt from '@assets/hero/hero-about.png';
import { href, absoluteUrl } from '@lib/href';
import { personSchema } from '@lib/schema';

export async function getStaticPaths() {
  const team = await getCollection('team', ({ data }) => data.published);
  return team.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { data } = person;
const { Content } = await render(person);
const url = absoluteUrl(`/team/${person.id}/`, Astro.site);
const jsonLd = [
  personSchema({
    url,
    name: data.name,
    jobTitle: data.title,
    email: data.email,
    sameAs: data.linkedin ? [data.linkedin] : [],
    siteUrl: absoluteUrl('/', Astro.site),
  }),
];
---

<BaseLayout
  title={`${data.name}, ${data.title}`}
  description={data.summary}
  ogType="profile"
  {jsonLd}
>
  <section class="profile-hero band-dark">
    <div class="profile-hero__bg" aria-hidden="true">
      <Image
        src={heroArt}
        alt=""
        format="webp"
        widths={[800, 1400]}
        sizes="100vw"
        loading="eager"
      />
    </div>
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'About', href: '/about/' },
          { label: 'Leadership', href: '/leadership/' },
          { label: data.name, href: `/team/${person.id}/` },
        ]}
      />
      <div class="profile-hero__grid">
        {data.photo && (
          <div class="profile-hero__photo">
            <Image
              src={data.photo}
              alt={data.photoAlt ?? data.name}
              width={400}
              height={400}
              widths={[240, 400, 600]}
              sizes="(min-width: 900px) 300px, 60vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}
        <div>
          <p class="eyebrow">Leadership</p>
          <h1>{data.name}</h1>
          <p class="profile-hero__title">{data.title}, Axis Energy</p>
          <div class="cluster profile-hero__actions">
            {data.email && (
              <a class="btn btn--primary" href={`mailto:${data.email}`}>
                <Icon name="lucide:mail" class="icon" /> Email {data.name.split(' ')[0]}
              </a>
            )}
            {data.linkedin && (
              <a class="btn btn--secondary" href={data.linkedin} rel="noopener" target="_blank">
                <Icon name="lucide:linkedin" class="icon" /> LinkedIn
              </a>
            )}
            {data.phone && (
              <a class="btn btn--secondary" href={`tel:+1${data.phone.replace(/\D/g, '')}`}>
                <Icon name="lucide:phone" class="icon" /> {data.phone}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container profile-body">
      <article class="prose">
        <h2>About {data.name.split(' ')[0]}</h2>
        <Content />
      </article>
      <aside class="profile-aside">
        {data.education && (
          <div class="card">
            <h3>Education</h3>
            <ul class="list-check">
              {data.education.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          </div>
        )}
        {data.credentials && (
          <div class="card">
            <h3>Credentials</h3>
            <ul class="list-check">
              {data.credentials.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        )}
        <a class="link-arrow" href={href('/leadership/')}>
          <Icon name="lucide:arrow-left" class="icon" /> All leadership
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .profile-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--page-hero-pad-top) var(--page-hero-pad-bottom);
  }

  .profile-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    filter: blur(14px) saturate(1.1);
    transform: scale(1.1);
  }

  .profile-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-hero .container {
    position: relative;
  }

  .profile-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .profile-hero__photo {
    width: min(200px, 44vw);
    aspect-ratio: 1;
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--shadow-3);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .profile-hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-hero h1 {
    color: #fff;
    font-size: var(--h1-page);
  }

  .profile-hero__title {
    font-size: var(--text-lg);
    color: var(--aqua-200);
    font-weight: 600;
  }

  .profile-hero__actions {
    margin-top: 1rem;
  }

  .profile-body {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .profile-aside {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .profile-aside h3 {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 900px) {
    .profile-hero__grid {
      grid-template-columns: auto 1fr;
      gap: 3rem;
    }

    .profile-body {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }
</style>
