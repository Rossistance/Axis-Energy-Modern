---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import { heroes } from '@data/heroes';
import { href, absoluteUrl } from '@lib/href';
import { personSchema } from '@lib/schema';

export async function getStaticPaths() {
  const team = await getCollection('team', ({ data }) => data.published);
  return team.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { data } = person;
const { Content } = await render(person);
const url = absoluteUrl(`/team/${person.id}/`, Astro.site);
const jsonLd = [
  personSchema({
    url,
    name: data.name,
    jobTitle: data.title,
    email: data.email,
    sameAs: data.linkedin ? [data.linkedin] : [],
    siteUrl: absoluteUrl('/', Astro.site),
  }),
];
---

<BaseLayout
  title={`${data.name}, ${data.title}`}
  description={data.summary}
  ogType="profile"
  {jsonLd}
>
  <PageHero
    eyebrow="Leadership"
    title={data.name}
    lead={`${data.title}, Axis Energy`}
    photo={heroes.team}
    crumbs={[
      { label: 'About', href: '/about/' },
      { label: 'Leadership', href: '/leadership/' },
      { label: data.name, href: `/team/${person.id}/` },
    ]}
  >
    {data.photo && (
      <div class="profile-portrait" slot="media">
        <Image
          src={data.photo}
          alt={data.photoAlt ?? data.name}
          width={120}
          height={120}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}
  </PageHero>

  <section class="section">
    <div class="container profile-body">
      {(data.email || data.linkedin || data.phone) && (
        <div class="card profile-contact">
          <h2 class="profile-contact__title">Contact {data.name.split(' ')[0]}</h2>
          <div class="cluster">
            {data.email && (
              <a class="btn btn--primary btn--sm" href={`mailto:${data.email}`}>
                <Icon name="lucide:mail" class="icon" /> Email
              </a>
            )}
            {data.linkedin && (
              <a
                class="btn btn--secondary btn--sm"
                href={data.linkedin}
                rel="noopener"
                target="_blank"
              >
                <Icon name="lucide:linkedin" class="icon" /> LinkedIn
              </a>
            )}
            {data.phone && (
              <a class="btn btn--secondary btn--sm" href={`tel:+1${data.phone.replace(/\D/g, '')}`}>
                <Icon name="lucide:phone" class="icon" /> {data.phone}
              </a>
            )}
          </div>
        </div>
      )}
      <article class="prose profile-bio">
        <h2>About {data.name.split(' ')[0]}</h2>
        <Content />
      </article>
      <aside class="profile-aside">
        {data.education && (
          <div class="card">
            <h3>Education</h3>
            <ul class="list-check">
              {data.education.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          </div>
        )}
        {data.credentials && (
          <div class="card">
            <h3>Credentials</h3>
            <ul class="list-check">
              {data.credentials.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        )}
        <a class="link-arrow" href={href('/leadership/')}>
          <Icon name="lucide:arrow-left" class="icon" /> All leadership
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .profile-portrait {
    flex: none;
    width: clamp(76px, 9vw, 112px);
    aspect-ratio: 1;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.35);
    box-shadow: var(--shadow-3);
  }

  .profile-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-bio > :global(:first-child) {
    margin-top: 0;
  }

  .profile-contact__title {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }

  .profile-body {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .profile-aside {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .profile-aside h3 {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }

  /* Desktop: bio on the left; contact card above the other cards on the right. */
  @media (min-width: 900px) {
    .profile-body {
      grid-template-columns: minmax(0, 1fr) 320px;
      grid-template-areas:
        'bio contact'
        'bio aside';
      grid-template-rows: auto 1fr;
      column-gap: clamp(2rem, 5vw, 4rem);
      row-gap: 1.25rem;
      align-items: start;
    }

    .profile-contact {
      grid-area: contact;
    }

    .profile-bio {
      grid-area: bio;
    }

    .profile-aside {
      grid-area: aside;
    }
  }
</style>
