---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import Pillars from '@components/Pillars.astro';
import StatStrip from '@components/StatStrip.astro';
import SafetyPartners from '@components/SafetyPartners.astro';
import { heroes } from '@data/heroes';
import { stats } from '@data/stats';
import { pillars, pillarsClose, hasCopy } from '@data/pillars';
import { routes } from '@data/routes';
import { href } from '@lib/href';

const preview = (import.meta.env.PUBLIC_SITE_MODE ?? 'preview') !== 'production';
// Preview builds show every card, placeholders included. Production builds leave out cards
// that have no copy yet (and the section, if none has), and say so in the build log.
const cards = preview ? pillars : pillars.filter(hasCopy);
if (cards.length < pillars.length) {
  console.warn(
    `[why-axis] ${pillars.length - cards.length} of ${pillars.length} "Total project peace of mind" cards have no copy yet and are left out of this production build (src/data/pillars.ts).`,
  );
}

const description =
  'Why owners and developers choose Axis Energy: total project peace of mind, a proven track record, and a safety program graded by Avetta, Veriforce and ISNetworld.';
---

<BaseLayout title="Why Axis" {description}>
  <PageHero
    eyebrow="Why Axis"
    title="We give our partners total project peace of mind."
    lead="Six commitments we keep on every site."
    photo={heroes.whyAxis}
    crumbs={[{ label: 'Why Axis', href: '/why-axis/' }]}
  />

  {cards.length > 0 && (
    <section class="section" aria-labelledby="pillars-title">
      <div class="container">
        <SectionHeading
          eyebrow="Total project peace of mind"
          title="What sets Axis apart"
          id="pillars-title"
        />
        <Pillars {cards} />
        <div class="pillars-close" data-reveal>
          <h3>{pillarsClose.title}</h3>
          <p class="lead">{pillarsClose.body}</p>
          <div class="cluster cluster--center pillars-close__actions">
            <a class="btn btn--primary btn--lg" href={href(routes.workWithAxis)}>
              Work with Axis
            </a>
            <a class="btn btn--secondary btn--lg" href={href(routes.projects)}>
              Explore our projects
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section band-alt" id="by-the-numbers" aria-labelledby="numbers-title">
    <div class="container">
      <SectionHeading
        eyebrow="By the numbers"
        title="A track record you can underwrite"
        lead="Recognized nationally by Solar Power World as a Top Solar Contractor every year we have submitted since 2021."
        id="numbers-title"
      />
      <StatStrip stats={stats} />
    </div>
  </section>

  <section class="section" id="safety" aria-labelledby="safety-title">
    <div class="container">
      <div class="split split--5-7">
        <div data-reveal>
          <p class="eyebrow">Outstanding safety</p>
          <h2 id="safety-title">Our people go home at the end of the day.</h2>
        </div>
        <div data-reveal>
          <p class="lead">
            As a partnership-based, employee-owned company, we see safety as our moral obligation,
            and therefore employ and enforce rigorous, industry-best safety practices to ensure that
            our people go home at the end of the day, and shield our customers from the negative
            impact of safety-related accidents.
          </p>
          <p>
            An experienced Axis superintendent is on every site, and every subcontractor is
            prequalified on safety record, licensing and insurance before work begins.
          </p>
        </div>
      </div>
      <SafetyPartners />
    </div>
  </section>
</BaseLayout>

<style>
  .pillars-close {
    max-width: 46rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    text-align: center;
  }

  .pillars-close h3 {
    font-size: clamp(1.4rem, 1.15rem + 1vw, 1.9rem);
    margin-bottom: 0.75rem;
  }

  .pillars-close__actions {
    margin-top: 1.5rem;
  }
</style>
