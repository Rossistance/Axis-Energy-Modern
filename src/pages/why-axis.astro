---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import Pillars from '@components/Pillars.astro';
import StatStrip from '@components/StatStrip.astro';
import SafetyPartners from '@components/SafetyPartners.astro';
import PromiseList from '@components/PromiseList.astro';
import { Icon } from 'astro-icon/components';
import Testimonial from '@components/Testimonial.astro';
import { brandLine, proofPoints } from '@data/promise';
import { visibleTestimonials } from '@data/testimonials';
import { heroes } from '@data/heroes';
import { stats } from '@data/stats';
import { pillars, pillarsClose, hasCopy } from '@data/pillars';
import { routes } from '@data/routes';
import { href } from '@lib/href';

const preview = (import.meta.env.PUBLIC_SITE_MODE ?? 'preview') !== 'production';
// Preview builds show every card, placeholders included. Production builds leave out cards
// that have no copy yet (and the section, if none has), and say so in the build log.
const cards = preview ? pillars : pillars.filter(hasCopy);
if (cards.length < pillars.length) {
  console.warn(
    `[why-axis] ${pillars.length - cards.length} of ${pillars.length} "Total project peace of mind" cards have no copy yet and are left out of this production build (src/data/pillars.ts).`,
  );
}

// Proof under By the numbers: the figures that exist and, in preview, the ones still to come.
// Production builds leave out points without a figure (safety rates come from 1910 Legacy's
// consolidated record, owner 2026-11-02) and testimonials not yet approved.
const proof = preview ? proofPoints : proofPoints.filter((p) => p.value);
const quotes = visibleTestimonials;

const description =
  'Why owners choose Axis Energy: one accountable team, a proven track record and a safety program graded by Avetta, Veriforce and ISNetworld.';
---

<BaseLayout title="Why Axis" {description}>
  <PageHero
    eyebrow="Why Axis"
    title={brandLine}
    lead="Seven commitments we make on every project, and the work we have already done to keep them."
    photo={heroes.whyAxis}
    crumbs={[{ label: 'Why Axis', href: '/why-axis/' }]}
  />

  <section class="section" id="promise" aria-labelledby="promise-title">
    <div class="container">
      <SectionHeading
        eyebrow="In writing"
        title="What we commit to on every project, and how you can hold us to it"
        lead="Ask about any of them in the first meeting, and check every one at turnover."
        id="promise-title"
      />
      <PromiseList />
    </div>
  </section>

  {cards.length > 0 && (
    <section class="section" aria-labelledby="pillars-title">
      <div class="container">
        <SectionHeading
          eyebrow="Total project peace of mind"
          title="What that means for your project"
          id="pillars-title"
        />
        <Pillars {cards} />
        <div class="pillars-close" data-reveal>
          <h3>{pillarsClose.title}</h3>
          <p class="lead">{pillarsClose.body}</p>
          <div class="cluster cluster--center pillars-close__actions">
            <a class="btn btn--primary btn--lg" href={href(routes.workWithAxis)}>
              Work with Axis
            </a>
            <a class="btn btn--secondary btn--lg" href={href(routes.projects)}>
              Explore our projects
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section band-alt" id="by-the-numbers" aria-labelledby="numbers-title">
    <div class="container">
      <SectionHeading
        eyebrow="By the numbers"
        title="A track record you can underwrite"
        lead="Recognized nationally by Solar Power World as a Top Solar Contractor every year we have submitted since 2021."
        id="numbers-title"
      />
      <StatStrip stats={stats} />
      {(proof.length > 0 || quotes.length > 0) && (
        <div class="proof-panel">
          {proof.length > 0 && (
            <ul class="proof-panel__list">
              {proof.map((p) => (
                <li class:list={{ 'is-pending': !p.value }}>
                  <Icon name={p.icon} />
                  <strong class="proof-panel__value">{p.value ?? 'To come'}</strong>
                  <span class="proof-panel__label">{p.label}</span>
                  {!p.value && <span class="proof-panel__note">Figure from {p.source}</span>}
                </li>
              ))}
            </ul>
          )}
          {quotes.map((t) => (
            <Testimonial testimonial={t} />
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section" id="safety" aria-labelledby="safety-title">
    <div class="container">
      <div class="split split--5-7">
        <div data-reveal>
          <p class="eyebrow">Outstanding safety</p>
          <h2 id="safety-title">Our people go home at the end of the day.</h2>
        </div>
        <div data-reveal>
          <p class="lead">
            As a partnership-based, employee-owned company, we see safety as our moral obligation,
            and therefore employ and enforce rigorous, industry-best safety practices to ensure that
            our people go home at the end of the day, and shield our customers from the negative
            impact of safety-related accidents.
          </p>
          <p>
            An experienced Axis superintendent is on every site, and every subcontractor is
            prequalified on safety record, licensing and insurance before work begins.
          </p>
        </div>
      </div>
      <SafetyPartners />
    </div>
  </section>
</BaseLayout>

<style>
  .proof-panel {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .proof-panel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 760px) {
    .proof-panel__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .proof-panel__list li {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    justify-items: start;
    padding: 1rem 1.1rem;
    border-radius: var(--r-md, 12px);
    background: var(--surface, #fff);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  /* Preview only: a point still waiting for its figure. */
  .proof-panel__list li.is-pending {
    box-shadow: none;
    border: 1px dashed var(--line-strong, #b9c6d0);
    background: transparent;
  }

  .proof-panel__list :global(svg) {
    width: 22px;
    height: 22px;
    color: var(--brand-green);
  }

  .proof-panel__value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--brand-navy);
  }

  .is-pending .proof-panel__value {
    font-size: 1rem;
    color: var(--text-muted);
  }

  .proof-panel__note {
    font-size: 0.8rem;
  }

  .pillars-close {
    max-width: 46rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    text-align: center;
  }

  .pillars-close h3 {
    font-size: clamp(1.4rem, 1.15rem + 1vw, 1.9rem);
    margin-bottom: 0.75rem;
  }

  .pillars-close__actions {
    margin-top: 1.5rem;
  }
</style>
