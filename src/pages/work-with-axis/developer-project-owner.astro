---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import FormShell from '@components/FormShell.astro';
import { heroes } from '@data/heroes';
import { rfqForm } from '@data/forms';
import { company } from '@data/company';
import { routes } from '@data/routes';
import { workWithAxis } from '@data/nav';
import { href } from '@lib/href';

const description =
  'Developers and project owners: tell Axis Energy about your solar EPC, battery storage, microgrid, electrical infrastructure or O&M project and we will follow up within one business day.';
const steps = [
  {
    title: 'We review your project',
    body: 'A member of the Axis team reads every request and matches it with the right project and preconstruction lead.',
  },
  {
    title: 'We talk',
    body: 'Expect a call or email within one business day to confirm scope, site details and timing.',
  },
  {
    title: 'You get a plan',
    body: 'A preliminary approach and, where the project is defined, a budgetary or firm proposal.',
  },
];
---

<BaseLayout title="Developer/Project Owner" {description} cta={false}>
  <PageHero
    eyebrow={workWithAxis.label}
    title="Developer/Project Owner"
    lead="Tell us about your solar, storage, microgrid, electrical or O&M project and we will follow up within one business day. Estimates are fine."
    photo={heroes.projectRequest}
    crumbs={[
      { label: workWithAxis.label, href: routes.workWithAxis },
      { label: 'Developer/Project Owner', href: routes.projectRequest },
    ]}
  />

  <section class="section">
    <div class="container form-layout">
      <div class="card form-card">
        <FormShell spec={rfqForm} endpointEnv="PUBLIC_FORM_ENDPOINT_RFQ" />
      </div>
      <aside class="form-aside">
        <div class="card">
          <h2 class="aside-title">What happens next</h2>
          <ol class="next-steps">
            {steps.map((s) => (
              <li>
                <strong>{s.title}</strong>
                <span>{s.body}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="card">
          <h2 class="aside-title">Prefer to talk?</h2>
          <p>
            <a class="big-link" href={`tel:${company.phone.tel}`}>
              <Icon name="lucide:phone" /> {company.phone.display}
            </a>
          </p>
          <p>
            <a class="big-link" href={`mailto:${company.email}`}>
              <Icon name="lucide:mail" /> {company.email}
            </a>
          </p>
          <p class="text-muted small">{company.hours}</p>
        </div>
        <div class="card">
          <h2 class="aside-title">Looking to work with us as a subcontractor?</h2>
          <p class="text-muted">
            Use the prequalification form instead so our preconstruction team can vet your company
            for upcoming scopes.
          </p>
          <a class="link-arrow" href={href(routes.subcontractor)}>
            Subcontractor prequalification <Icon name="lucide:arrow-right" class="icon" />
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .form-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .form-card {
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .form-aside {
    display: grid;
    gap: 1.25rem;
  }

  .aside-title {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }

  .next-steps {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.9rem;
    font-size: var(--text-sm);
  }

  .next-steps li {
    display: grid;
    gap: 0.15rem;
  }

  .next-steps span {
    color: var(--text-muted);
  }

  .big-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .big-link svg {
    width: 18px;
    height: 18px;
    color: var(--brand-green);
  }

  .small {
    font-size: var(--text-sm);
  }

  @media (min-width: 1024px) {
    .form-layout {
      grid-template-columns: minmax(0, 1fr) 340px;
    }

    .form-aside {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
