---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import FormShell from '@components/FormShell.astro';
import heroArt from '@assets/hero/hero-careers.png';
import { subcontractorForm } from '@data/forms';
import { company } from '@data/company';
import { href } from '@lib/href';

const description =
  'Start the subcontractor prequalification process with Axis Energy. Tell us about your trades, licensing, insurance, safety record and experience to be considered for upcoming solar and electrical scopes.';
const lookFor = [
  {
    icon: 'lucide:shield-check',
    title: 'Safety record',
    body: 'EMR, TRIR and a written safety program. We see safety as a moral obligation and expect our partners to as well.',
  },
  {
    icon: 'lucide:file-badge',
    title: 'Licensing and insurance',
    body: 'Current contractor licences in the states you work in, plus general liability, auto, umbrella and workers’ compensation coverage.',
  },
  {
    icon: 'lucide:badge-check',
    title: 'Quality and responsiveness',
    body: 'References who will vouch for your workmanship, schedule performance and communication.',
  },
  {
    icon: 'lucide:map',
    title: 'Coverage and capacity',
    body: 'Crews and equipment where our projects are — the Carolinas, Arkansas, Mississippi, Tennessee, Kentucky, Virginia, Pennsylvania, Colorado and Texas.',
  },
];
const trades = [
  'Civil, grading and erosion control',
  'Pile driving and foundations',
  'Racking and module installation',
  'DC and AC electrical',
  'Medium-voltage and interconnection',
  'SCADA and communications',
  'Fencing and vegetation management',
  'Hauling and logistics',
];
const documents = [
  'Certificate of insurance (COI)',
  'W-9',
  'Written safety program',
  'EMR letter from your carrier (3 years)',
  'OSHA 300A logs (3 years)',
  'Contractor licence copies',
  'Three trade references',
];
---

<BaseLayout title="Subcontractor Prequalification" {description} cta={false}>
  <PageHero
    eyebrow="Subcontractors"
    title="Start the vetting process to work with Axis"
    lead="Axis builds with a network of trusted trade partners across the Southeast and beyond. Complete the prequalification below to be considered for upcoming civil, mechanical and electrical scopes."
    art={heroArt}
    artPosition="20% 55%"
    artScale={1.3}
    ratio="1 / 1"
    crumbs={[{ label: 'Subcontractors', href: '/subcontractors/' }]}
  />

  <section class="section section--sm" aria-labelledby="lookfor-title">
    <div class="container">
      <h2 id="lookfor-title" class="sr-only">
        What we look for
      </h2>
      <div class="grid grid--4" data-reveal-group>
        {lookFor.map((l) => (
          <div class="card">
            <div class="icon-tile">
              <Icon name={l.icon} />
            </div>
            <h3 class="lf-title">{l.title}</h3>
            <p class="text-muted small">{l.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container form-layout">
      <div class="card form-card">
        <FormShell spec={subcontractorForm} endpointEnv="PUBLIC_FORM_ENDPOINT_SUBS" />
      </div>
      <aside class="form-aside">
        <div class="card">
          <h2 class="aside-title">Trades we typically need</h2>
          <ul class="list-check small">
            {trades.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
        <div class="card">
          <h2 class="aside-title">Documents we will request</h2>
          <p class="text-muted small">
            Nothing to upload now. If your capabilities match upcoming work, our preconstruction
            team will request these by secure email.
          </p>
          <ul class="list-check small">
            {documents.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </div>
        <div class="card">
          <h2 class="aside-title">Questions?</h2>
          <p>
            <a
              class="big-link"
              href={`mailto:${company.email}?subject=${encodeURIComponent('Subcontractor prequalification question')}`}
            >
              <Icon name="lucide:mail" /> {company.email}
            </a>
          </p>
          <p>
            <a class="big-link" href={`tel:${company.phone.tel}`}>
              <Icon name="lucide:phone" /> {company.phone.display}
            </a>
          </p>
          <p class="text-muted small">
            Looking for employment instead? <a href={href('/careers/')}>See careers</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .lf-title {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .form-layout {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .form-card {
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .form-aside {
    display: grid;
    gap: 1.25rem;
  }

  .aside-title {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }

  .big-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .big-link svg {
    width: 18px;
    height: 18px;
    color: var(--brand-green);
  }

  .small {
    font-size: var(--text-sm);
  }

  @media (min-width: 1024px) {
    .form-layout {
      grid-template-columns: minmax(0, 1fr) 340px;
    }

    .form-aside {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
