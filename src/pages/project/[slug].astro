---
/**
 * Project page, reorganized 2026-10-01 so the facts come first: a compact title band (no
 * photo, since the card that led here already showed it), then an overview with the key
 * figures, the narrative, the details and Axis's scope beside a moderate photo; delivery
 * notes and owner benefits follow in compact rows, then related projects.
 */
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { projectMarkets, marketPath } from '@data/project-markets';
import { routes } from '@data/routes';
import { href, absoluteUrl } from '@lib/href';
import { formatSize, formatStorage, formatCommissioned } from '@lib/format';
import { getPublishedProjects, projectLocation, TYPE_LABELS, type Project } from '@lib/projects';
import { projectSchema } from '@lib/schema';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project, i) => {
    // Related: same market and type first, then the rest in portfolio order.
    const score = (p: Project) =>
      (project.data.market && p.data.market === project.data.market ? 2 : 0) +
      (p.data.type === project.data.type ? 1 : 0);
    const related = projects
      .filter((p) => p.id !== project.id)
      .sort((a, b) => score(b) - score(a))
      .slice(0, 4);
    return {
      params: { slug: project.id },
      props: { project, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null, related },
    };
  });
}

const { project, prev, next, related } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const location = projectLocation(project);
const url = absoluteUrl(`/project/${project.id}/`, Astro.site);
const jsonLd = [
  projectSchema({
    url,
    name: data.title,
    description: data.summary,
    location,
    siteUrl: absoluteUrl('/', Astro.site),
    dateCompleted: data.commissioned,
  }),
];
const ogImage = data.image ? data.image.src : undefined;
const market = projectMarkets
  .flatMap((m) => [m, ...(m.children ?? [])])
  .find((m) => m.id === data.market);

const storage = formatStorage(data.storageMwh);
const completed = formatCommissioned(data.commissioned) || (data.year ? String(data.year) : '');
const figures = [
  { label: 'Solar', value: formatSize(data.sizeMwdc) },
  { label: 'Storage', value: storage ?? '' },
  { label: data.commissioned ? 'Commissioned' : 'Completed', value: completed },
  { label: 'Axis role', value: data.role.join(', '), text: true },
].filter((f) => f.value);
const details = [
  { label: 'Type', value: TYPE_LABELS[data.type] },
  { label: 'Sites', value: data.sites && data.sites > 1 ? String(data.sites) : '' },
  { label: 'Mount', value: data.mount ?? '' },
  { label: 'Modules', value: data.modules ?? '' },
  { label: 'Storage system', value: storage && data.storageBrand ? data.storageBrand : '' },
].filter((d) => d.value);
const delivery = [
  { title: 'Challenge', icon: 'lucide:target', body: data.challenge },
  { title: 'Axis approach', icon: 'lucide:hard-hat', body: data.approach },
  { title: 'Impact', icon: 'lucide:trending-up', body: data.impact },
].filter((d) => d.body);
---

<BaseLayout title={data.title} description={data.summary} {jsonLd} ogImage={ogImage}>
  <section class="project-head band-dark" aria-labelledby="page-title">
    <div class="container project-head__inner">
      <Breadcrumbs
        items={[
          { label: 'Projects', href: routes.projects },
          { label: data.title, href: `/project/${project.id}/` },
        ]}
      />
      <p class="eyebrow">Project · {TYPE_LABELS[data.type]}</p>
      <h1 id="page-title">{data.title}</h1>
      <ul class="project-head__meta">
        <li>
          <Icon name="lucide:map-pin" />
          {location}
        </li>
        {market && (
          <li>
            <Icon name={market.icon} />
            <a href={href(marketPath(market.id))}>{market.title}</a>
          </li>
        )}
      </ul>
    </div>
  </section>

  <section class="section section--sm overview" aria-label="Project overview">
    <div class="container overview__grid">
      <div class="overview__main">
        <dl class="figures">
          {figures.map((f) => (
            <div class:list={['figures__item', { 'figures__item--text': f.text }]}>
              <dt>{f.label}</dt>
              <dd class="tabular">{f.value}</dd>
            </div>
          ))}
        </dl>

        <div class="prose overview__story">
          <Content />
        </div>

        {details.length > 0 && (
          <dl class="details">
            {details.map((d) => (
              <div>
                <dt>{d.label}</dt>
                <dd>{d.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {data.scope && (
          <div class="scope">
            <h2 class="mini-title">Axis scope</h2>
            <ul class="list-check scope__list">
              {data.scope.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <aside class="overview__media" aria-label="Project photos">
        {data.image && (
          <figure class="photo-frame" style={`max-width: ${data.image.width}px`}>
            <Image
              src={data.image}
              alt={data.imageAlt ?? data.title}
              widths={[480, 640, 960].filter((w) => w < data.image!.width).concat(data.image.width)}
              sizes="(min-width: 900px) 460px, 100vw"
              loading="eager"
              decoding="async"
            />
            {data.imageCredit && <figcaption>{data.imageCredit}</figcaption>}
          </figure>
        )}
        {data.gallery?.map((photo) => (
          <figure class="photo-frame photo-frame--crop">
            <Image
              src={photo.image}
              alt={photo.alt}
              widths={[340, 460].filter((w) => w < photo.image.width).concat(photo.image.width)}
              sizes="(min-width: 900px) 460px, 100vw"
              loading="lazy"
              decoding="async"
            />
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))}
        <p class="overview__cta">
          Planning something similar?
          <a href={href(routes.projectRequest)}>
            Start a project request <Icon name="lucide:arrow-right" />
          </a>
        </p>
      </aside>
    </div>
  </section>

  {(delivery.length > 0 || data.benefits) && (
    <section class="section section--sm band-alt" aria-labelledby="delivery-title">
      <div class="container">
        <h2 id="delivery-title" class="mini-title">
          How it was delivered
        </h2>
        {delivery.length > 0 && (
          <div class="delivery">
            {delivery.map((d) => (
              <div class="card delivery__item">
                <h3>
                  <Icon name={d.icon} /> {d.title}
                </h3>
                <p>{d.body}</p>
              </div>
            ))}
          </div>
        )}
        {data.benefits && (
          <>
            <h2 class="mini-title benefits__title">Why it matters to owners</h2>
            <ul class="benefits">
              {data.benefits.map((b) => (
                <li>
                  <strong>{b.title}</strong>
                  <span>{b.body}</span>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  <section class="section section--sm" aria-labelledby="related-title">
    <div class="container">
      <div class="related__head">
        <h2 id="related-title" class="mini-title">
          More projects
        </h2>
        <a class="link-arrow" href={href(routes.projects)}>
          All projects <Icon name="lucide:arrow-right" class="icon" />
        </a>
      </div>
      <div class="grid related__grid" data-reveal-group>
        {related.map((p) => (
          <ProjectCard project={p} />
        ))}
      </div>
      <nav class="pn" aria-label="Project navigation">
        {prev ? (
          <a href={href(`/project/${prev.id}/`)} class="pn__link">
            <Icon name="lucide:arrow-left" />
            <span>
              <small>Previous</small>
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a href={href(`/project/${next.id}/`)} class="pn__link pn__link--next">
            <span>
              <small>Next</small>
              {next.data.title}
            </span>
            <Icon name="lucide:arrow-right" />
          </a>
        ) : (
          <span />
        )}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  /* Title band: no photo, so the page opens on new information. */
  .project-head {
    background: var(--grad-band);
  }

  .project-head__inner {
    padding-block: clamp(1.1rem, 2.4vw, 1.6rem) clamp(1.25rem, 2.8vw, 1.9rem);
  }

  .project-head .eyebrow {
    margin-bottom: 0.45rem;
  }

  .project-head h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.9rem, 1.4rem + 1.9vw, 2.9rem);
    text-wrap: balance;
  }

  .project-head__meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0.7rem 0 0;
    padding: 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-sm);
  }

  .project-head__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .project-head__meta :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--aqua-400);
    flex: none;
  }

  .project-head__meta a {
    color: #fff;
    text-decoration-color: rgba(158, 237, 230, 0.55);
    text-underline-offset: 0.2em;
  }

  /* Overview: the facts beside the photo. */
  .overview__grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .overview__main {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: 0.6rem;
    margin: 0;
  }

  .figures__item {
    display: grid;
    gap: 0.15rem;
    align-content: start;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--brand-green);
    border-radius: var(--r-md);
    background: var(--surface, #fff);
  }

  .figures dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .figures dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.35rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--brand-blue);
  }

  .figures__item--text dd {
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text);
  }

  .overview__story {
    max-width: none;
  }

  .overview__story :global(p) {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .overview__story :global(p + p) {
    margin-top: 0.8rem;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 0.6rem 1.25rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .details dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .details dd {
    margin: 0.1rem 0 0;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .mini-title {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }

  .scope__list {
    gap: 0.45rem 1.5rem;
    font-size: 0.95rem;
  }

  .overview__media {
    display: grid;
    gap: 1rem;
    align-content: start;
    justify-items: center;
  }

  .overview__cta {
    justify-self: stretch;
  }

  .photo-frame {
    margin: 0;
    width: 100%;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--mist-100);
  }

  .photo-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Secondary photos: a shorter 16:9 crop, so the photo column stays beside the facts. */
  .photo-frame--crop img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .photo-frame figcaption {
    padding: 0.5rem 0.85rem;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .overview__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0.8rem 1rem;
    border-radius: var(--r-md);
    background: linear-gradient(135deg, rgba(0, 75, 141, 0.06), rgba(0, 135, 82, 0.08));
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .overview__cta a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 700;
  }

  .overview__cta :global(svg) {
    width: 15px;
    height: 15px;
  }

  /* Delivery and benefits */
  .delivery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.85rem;
  }

  .delivery__item {
    padding: 1rem 1.1rem;
  }

  .delivery__item h3 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }

  .delivery__item :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--brand-green);
    flex: none;
  }

  .delivery__item p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .benefits__title {
    margin-top: 1.5rem;
  }

  .benefits {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.85rem 1.5rem;
    margin: 0;
    padding: 0;
  }

  .benefits li {
    display: grid;
    gap: 0.2rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--brand-green);
    font-size: 0.95rem;
  }

  .benefits span {
    color: var(--text-muted);
  }

  /* Related projects */
  .related__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.25rem;
  }

  .related__grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  .pn {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    grid-template-columns: 1fr 1fr;
  }

  .pn__link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-weight: 600;
    color: var(--text);
  }

  .pn__link span {
    display: grid;
  }

  .pn__link small {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .pn__link--next {
    justify-self: end;
    text-align: right;
  }

  .pn :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--brand-green);
    flex: none;
  }

  @media (max-width: 559px) {
    .figures__item {
      padding: 0.55rem 0.7rem;
    }
  }

  @media (min-width: 640px) {
    .scope__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .overview__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
