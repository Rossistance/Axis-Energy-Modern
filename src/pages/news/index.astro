---
/**
 * News: the latest posts from the Axis Energy LinkedIn page, each linking to the post on
 * LinkedIn. Posts are read at build time (src/lib/news/); see docs/HANDOFF.md to connect
 * the feed.
 */
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import PostCard from '@components/PostCard.astro';
import { heroes } from '@data/heroes';
import { company } from '@data/company';
import { getPosts } from '@lib/news';

const { posts, source, warning } = await getPosts();
const preview = (import.meta.env.PUBLIC_SITE_MODE ?? 'preview') !== 'production';
const description =
  'News from Axis Energy: project milestones, team news and company updates from the Axis Energy LinkedIn page.';
---

<BaseLayout title="News" {description}>
  <PageHero
    eyebrow="News"
    title="News from Axis"
    lead="Project milestones, team news and company updates, straight from the Axis Energy LinkedIn page."
    photo={heroes.news}
    crumbs={[{ label: 'News', href: '/news/' }]}
  />

  <section class="section" aria-labelledby="posts-title">
    <div class="container">
      <SectionHeading eyebrow="On LinkedIn" title="Latest posts" id="posts-title" align="row">
        <a class="btn btn--secondary" href={company.linkedin} rel="noopener" target="_blank">
          <Icon name="lucide:linkedin" class="icon" /> Follow Axis on LinkedIn
        </a>
      </SectionHeading>

      {preview && source === 'static' && (
        <p class="feed-note" role="note">
          <Icon name="lucide:info" />
          <span>
            {warning ? (
              <>
                <strong>The LinkedIn feed could not be read at build time</strong> ({warning}).
              </>
            ) : (
              <strong>LinkedIn feed not connected yet.</strong>
            )}{' '}
            The sample cards show the layout. Once the feed is connected (docs/HANDOFF.md), the
            latest posts Axis Energy publishes on its LinkedIn page appear here automatically;
            reposts and posts that only tag Axis are left out.
          </span>
        </p>
      )}

      {posts.length > 0 ? (
        <div class="grid grid--3 posts" data-reveal-group>
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="card posts-empty">
          <Icon name="lucide:linkedin" />
          <p>
            Follow Axis Energy on LinkedIn for project milestones, team news and company updates.
          </p>
          <a class="btn btn--primary" href={company.linkedin} rel="noopener" target="_blank">
            Follow Axis on LinkedIn
          </a>
        </div>
      )}

      <p class="media-note">
        Media inquiries: <a href={`mailto:${company.email}`}>{company.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .feed-note {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0 0 1.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid #f0d58a;
    border-radius: var(--r-md);
    background: #fff8e6;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .feed-note :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 0.1rem;
    color: #8a6100;
  }

  .posts-empty {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    padding: clamp(2rem, 5vw, 3rem);
    text-align: center;
  }

  .posts-empty :global(svg) {
    width: 36px;
    height: 36px;
    color: var(--brand-blue);
  }

  .posts-empty p {
    max-width: 46ch;
    color: var(--text-muted);
  }

  .media-note {
    margin: 2rem 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
