---
/**
 * Markets: the owners Axis builds for, one section per market with up to three of the
 * published projects delivered for each; the rest are on the Projects page (owner,
 * 2026-10-28). The Markets menu and the home page diagram jump to these sections
 * (src/data/project-markets.ts). Moved here from the Projects page on 2026-10-01.
 */
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import MarketProjects from '@components/MarketProjects.astro';
import { heroes } from '@data/heroes';
import {
  projectMarkets,
  MARKET_PROFILE_LIMIT,
  RETIRED_MARKETS,
  type ProjectMarket,
} from '@data/project-markets';
import { routes } from '@data/routes';
import { href } from '@lib/href';
import { getPublishedProjects, type Project } from '@lib/projects';

const projects = await getPublishedProjects();
const inMarket = (m: ProjectMarket): Project[] =>
  projects.filter((p) => p.data.market === m.id).slice(0, MARKET_PROFILE_LIMIT);
const description =
  'The markets Axis Energy serves: commercial and industrial owners, electric cooperatives and utilities, municipal and institutional owners, and developers and independent power producers.';
---

<BaseLayout title="Markets" {description}>
  <PageHero
    eyebrow="Markets"
    title="Markets we serve"
    lead="The owners we build for, with a few of the projects delivered for each."
    photo={heroes.markets}
    crumbs={[{ label: 'Markets', href: routes.markets }]}
  />

  <section class="section markets" aria-label="Markets">
    <div class="container">
      <div class="markets__list">
        {projectMarkets.map((market) => (
          <section class="market" id={market.id} aria-labelledby={`${market.id}-title`}>
            <div class="market__intro">
              <div class="icon-tile">
                <Icon name={market.icon} />
              </div>
              <h2 id={`${market.id}-title`}>{market.title}</h2>
              <p>{market.summary}</p>
            </div>
            <div class="market__work">
              <MarketProjects projects={inMarket(market)} emptyNote={market.emptyNote} />
            </div>
          </section>
        ))}
      </div>

      <p class="markets__more">
        <a class="btn btn--primary" href={href(routes.projects)}>
          See all projects <Icon name="lucide:arrow-right" class="icon" />
        </a>
        <a class="btn btn--secondary" href={href(routes.caseStudies)}>
          Request case studies <Icon name="lucide:arrow-right" class="icon" />
        </a>
      </p>
    </div>
  </section>

  <script is:inline define:vars={{ retired: RETIRED_MARKETS }}>
    // /markets/#investor-owned and other merged sections: jump to the market that took them in.
    const target = retired[decodeURIComponent(location.hash.slice(1))];
    if (target) location.replace(`#${target}`);
  </script>
</BaseLayout>

<style>
  .markets__list {
    display: grid;
    gap: 1.25rem;
  }

  .market {
    border-radius: var(--r-lg);
  }

  .markets__list > .market {
    display: grid;
    gap: 1.25rem 2.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--surface, #fff);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
  }

  .market__intro h2 {
    margin: 0.85rem 0 0.4rem;
    font-size: 1.3rem;
  }

  .market__intro p {
    color: var(--text-muted);
    margin: 0;
  }

  .market__work {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .markets__more {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
  }

  /* Arriving from the Markets menu or the home page: a brief highlight on the section. */
  @media (prefers-reduced-motion: no-preference) {
    .market:target {
      animation: market-arrive 1.8s var(--ease-out);
    }
  }

  @keyframes market-arrive {
    from {
      box-shadow:
        0 0 0 3px var(--aqua-400),
        var(--shadow-2);
    }
  }

  @media (min-width: 900px) {
    .markets__list > .market {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
</style>
