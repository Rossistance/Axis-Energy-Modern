---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import FootprintMap from '@components/FootprintMap.astro';
import { rankings } from '@data/stats';
import { absoluteUrl } from '@lib/href';
import { getPublishedProjects, carouselSlides } from '@lib/projects';
import { webPageSchema } from '@lib/schema';

/** Hero carousel: real project photos, in project order. */
const heroSlides = carouselSlides(await getPublishedProjects());
const years = rankings.map((r) => r.year).sort((a, b) => a - b);
const recognition = `${years[0]}–${years[years.length - 1]}`;

const description =
  'Axis Energy is an employee-owned EPC and O&M contractor building solar, battery storage and microgrid projects across the lower 48 states, with operations and maintenance in North Carolina, South Carolina, Georgia and Virginia. A 1910 Legacy Enterprises company headquartered in Holly Springs, NC.';
const jsonLd = [
  webPageSchema({
    url: absoluteUrl('/', Astro.site),
    name: 'Axis Energy',
    description,
    siteUrl: absoluteUrl('/', Astro.site),
  }),
];
---

<BaseLayout
  title="Axis Energy | EPC and O&M Solutions for Renewable Energy"
  brandSuffix={false}
  {description}
  {jsonLd}
>
  <Hero
    eyebrow="EPC + O&M for commercial, industrial and utility‑scale solar"
    title="The Power of Partnership"
    lead="Solar, battery storage and microgrids built for performance."
    primary={{ label: 'Request a quote', href: '/request-a-quote/' }}
    secondary={{ label: 'See our work', href: '/projects/' }}
    slides={heroSlides}
    chips={[
      { icon: 'lucide:sun', label: '150 MW+ solar constructed', href: '/projects/' },
      { icon: 'lucide:users', label: '100% employee-owned', href: '/about/' },
      { icon: 'lucide:award', label: `Top Solar Contractor ${recognition}`, href: '/news/' },
    ]}
    trust={[
      '100% employee-owned through the 1910 Legacy ESOP',
      'A 1910 Legacy Enterprises company',
      `Solar Power World Top Solar Contractor, ${recognition}`,
      'Headquartered in Holly Springs, North Carolina',
    ]}
  />

  <FootprintMap />
</BaseLayout>
