---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import FootprintMap from '@components/FootprintMap.astro';
import PartnershipDiagram from '@components/PartnershipDiagram.astro';
import ThreePs from '@components/ThreePs.astro';
import { rankings } from '@data/stats';
import { absoluteUrl } from '@lib/href';
import { getPublishedProjects, carouselSlides } from '@lib/projects';
import { webPageSchema } from '@lib/schema';

/** Hero carousel: real project photos, in project order. */
const heroSlides = carouselSlides(await getPublishedProjects());
const years = rankings.map((r) => r.year).sort((a, b) => a - b);
const recognition = `${years[0]}–${years[years.length - 1]}`;

const description =
  'Employee-owned solar, storage, microgrid and O&M contractor in Holly Springs, NC, building across the lower 48 states. A 1910 Legacy Enterprises company.';
const jsonLd = [
  webPageSchema({
    url: absoluteUrl('/', Astro.site),
    name: 'Axis Energy',
    description,
    siteUrl: absoluteUrl('/', Astro.site),
  }),
];
---

<BaseLayout
  title="Axis Energy | EPC and O&M Solutions for Renewable Energy"
  brandSuffix={false}
  {description}
  {jsonLd}
>
  <Hero
    slides={heroSlides}
    chips={[
      { icon: 'lucide:sun', label: '150 MW+ solar built by our team', href: '/projects/' },
      { icon: 'lucide:users', label: '100% employee-owned', href: '/about/' },
      {
        icon: 'lucide:award',
        label: `Top Solar Contractor ${recognition}`,
        href: '/why-axis/#by-the-numbers',
      },
    ]}
    trust={[
      '100% employee-owned through the 1910 Legacy ESOP',
      'Bonding and financial backing through 1910 Legacy Enterprises',
      `Solar Power World Top Solar Contractor, ${recognition}`,
      'Headquartered in Holly Springs, North Carolina',
    ]}
  >
    <PartnershipDiagram />
  </Hero>

  <ThreePs />

  <FootprintMap />
</BaseLayout>
