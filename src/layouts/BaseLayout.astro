---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/inter';
import jakartaWoff2 from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '@styles/tokens.css';
import '@styles/base.css';
import '@styles/motion.css';
import '@styles/forms.css';
import Seo from '@components/Seo.astro';
import SkipLink from '@components/SkipLink.astro';
import PreviewRibbon from '@components/PreviewRibbon.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import CTABand from '@components/CTABand.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** true = full band, 'compact' = short band, false = none */
  cta?: boolean | 'compact';
  brandSuffix?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  ogImage,
  ogType,
  noindex,
  jsonLd,
  cta = true,
  brandSuffix,
  bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {title} {description} {ogImage} {ogType} {noindex} {jsonLd} {brandSuffix} />
    <link rel="preload" as="font" type="font/woff2" href={jakartaWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <SkipLink />
    <PreviewRibbon />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {cta && <CTABand compact={cta === 'compact'} />}
    <Footer />
    <script>
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reduce) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
