# Copy to .env for local development. All values are optional.

# Canonical site URL and base path.
# GitHub Pages project site (default):  SITE_URL=https://rossistance.github.io  SITE_BASE=/Axis-Energy-Modern
# Custom domain:                        SITE_URL=https://www.axis-energyinc.com SITE_BASE=/
SITE_URL=https://rossistance.github.io
SITE_BASE=/Axis-Energy-Modern

# "preview" shows the review ribbon, marks sample jobs and keeps forms in review mode.
# "production" hides all of that. Forms only send when an endpoint below is set.
PUBLIC_SITE_MODE=preview

# Form endpoints (Formspree-compatible JSON POST). Leave empty to keep a form in review mode.
PUBLIC_FORM_ENDPOINT_CONTACT=
PUBLIC_FORM_ENDPOINT_RFQ=
PUBLIC_FORM_ENDPOINT_SUBS=

# Jobs feed source: static | greenhouse | lever | workable | bamboohr | jazzhr | json-url
JOBS_SOURCE=static
# Board/company identifier for the chosen ATS (e.g. Greenhouse board token, Lever site, Workable subdomain)
JOBS_BOARD=
# Full URL for JOBS_SOURCE=json-url (must return an array of {title, location, url, ...})
JOBS_URL=
# Public job-board pages linked from the Careers page (leave empty to hide a button)
PUBLIC_JOBS_LINKEDIN_URL=https://www.linkedin.com/company/axis-energy-inc/jobs/
PUBLIC_JOBS_INDEED_URL=

# News page: posts from the Axis Energy LinkedIn page. static | linkedin | json-url
# static reads src/content/posts/ (sample cards in preview). See docs/HANDOFF.md.
NEWS_SOURCE=static
# Number of posts shown (default 9)
NEWS_LIMIT=
# linkedin: the company page's numeric id, and a token from an app with the Community
# Management API (scopes r_organization_social and w_organization_social, granted by a
# page admin). Access tokens last 60 days; with a refresh token, client id and secret the
# build renews it itself.
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn-Version header (YYYYMM, default 202609); versions are retired after about a year
LINKEDIN_API_VERSION=
# Set to true to include reposts. Posts that only tag Axis never appear.
LINKEDIN_INCLUDE_RESHARES=
# json-url: a JSON feed of [{ url, date, title?, summary, image?, imageAlt? }]
NEWS_URL=
