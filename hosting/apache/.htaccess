# Legacy WordPress URLs and moved pages -> new site (Apache / cPanel). Place in the document root.
RewriteEngine On
RewriteRule ^team/?$ /about/leadership/ [R=301,L]
RewriteRule ^leadership/?$ /about/leadership/ [R=301,L]
RewriteRule ^project/?$ /projects/ [R=301,L]
RewriteRule ^category/general/?$ /news/ [R=301,L]
RewriteRule ^project-category/general/?$ /projects/ [R=301,L]
RewriteRule ^(news/)?five-takeaways-from-a-nc-energy-policy-panel/?$ /news/ [R=301,L]
RewriteRule ^(news/)?solar-could-provide-25-of-the-worlds-energy-by-2050/?$ /news/ [R=301,L]
RewriteRule ^request-a-quote/?$ /work-with-axis/developer-project-owner/ [R=301,L]
RewriteRule ^subcontractors/?$ /work-with-axis/subcontractor/ [R=301,L]
RewriteRule ^services/om-and-technical-services/?$ /om-and-technical-services/ [R=301,L]
RewriteRule ^services/om-and-technical-services/([a-z-]+)/?$ /om-and-technical-services/#$1 [R=301,L,NE]
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]
ErrorDocument 404 /404.html

# Security headers (audit M2, 2026-11-20). The same six headers are in every file in hosting/;
# tests/security-headers.spec.ts loads every page under this policy and checks the files agree.
# connect-src and form-action allow any https: origin so the form service works whichever one
# is chosen; narrow them to its origin once it is known.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https:; form-action 'self' https: mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Cache hashed assets for a year; HTML briefly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  <FilesMatch "\.(css|js|avif|webp|png|jpg|svg|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
