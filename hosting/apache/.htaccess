# Legacy WordPress URLs and moved pages -> new site (Apache / cPanel). Place in the document root.
RewriteEngine On
RewriteRule ^team/?$ /about/leadership/ [R=301,L]
RewriteRule ^leadership/?$ /about/leadership/ [R=301,L]
RewriteRule ^project/?$ /projects/ [R=301,L]
RewriteRule ^category/general/?$ /news/ [R=301,L]
RewriteRule ^project-category/general/?$ /projects/ [R=301,L]
RewriteRule ^(news/)?five-takeaways-from-a-nc-energy-policy-panel/?$ /news/ [R=301,L]
RewriteRule ^(news/)?solar-could-provide-25-of-the-worlds-energy-by-2050/?$ /news/ [R=301,L]
RewriteRule ^request-a-quote/?$ /work-with-axis/developer-project-owner/ [R=301,L]
RewriteRule ^subcontractors/?$ /work-with-axis/subcontractor/ [R=301,L]
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]
ErrorDocument 404 /404.html

# Cache hashed assets for a year; HTML briefly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  <FilesMatch "\.(css|js|avif|webp|png|jpg|svg|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
